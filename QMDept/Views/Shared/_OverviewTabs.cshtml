@model string
@* Tổng quan của Trưởng phòng / Quản trị (yêu cầu 2026-10-20): 3 mục Dự án / Nhân sự / Kế hoạch tháng + ô "Xem màn hình" (chuyển từ thanh trên).
   Model = khóa mục đang chọn: projects | people | month. *@
@{
    var req = Context.Request;
    // Leader (yêu cầu 2026-10-20) cũng có 3 mục này: Dự án / Nhân sự (nhóm mình) / Kế hoạch tháng (đã chuyển từ Kế hoạch & duyệt)
    var ld = Scope.Account.Role == Role.Leader;
    var home = ld ? "/Leader/Overview" : "/Manager/Overview";
    // Leader: "Nhân sự nhóm" (nhóm mình); Leader được giao quản lý nhân sự (HrDuty) có thêm "Nhân sự phòng" ngay sau (yêu cầu 2026-10-21); TP: "Nhân sự" (cả phòng)
    var tabs = new List<(string Key, string Path, string Label)>
    {
        ("projects", home, "Dự án"),
        ("people", home + "?s=people", ld ? "Nhân sự nhóm" : "Nhân sự"),
    };
    if (ld && Scope.Account.HrDuty) tabs.Add(("dept", "/Leader/Department", "Nhân sự phòng"));
    tabs.Add(("month", ld ? "/Staff/Month?as=mine" : "/Staff/Month?as=all", "Kế hoạch tháng"));
}
@Ui.Head(1, "Tổng quan")
@Ui.Subtabs(tabs.Select(t => (Ui.To(req, t.Path), t.Label, t.Key == Model)))
@* Ô "Xem màn hình" chỉ ở mục Kế hoạch tháng: chọn người nào thì xem KẾ HOẠCH THÁNG của người đó (chỉ xem) — yêu cầu 2026-10-20 *@
@if (Model == "month" && Scope.Subordinates.Count > 0)
{
    <form method="get" action="@req.Path" class="row" style="margin-bottom:12px">
        @if (!string.IsNullOrEmpty(req.Query["d"])) { <input type="hidden" name="d" value="@req.Query["d"]"> }
        <span class="note" style="white-space:nowrap">Xem màn hình:</span>
        <select class="in" name="as" data-autosubmit data-combo aria-label="Chọn người để xem kế hoạch tháng">
            @if (!Scope.IsViewingOther) { <option value="" selected disabled hidden>Chọn người</option> }
            @foreach (var g in Scope.Subordinates.GroupBy(p => p.Role))
            {
                <optgroup label="@Labels.Title(g.Key)">
                    @foreach (var p in g) { <option value="@p.Id" selected="@(Scope.IsViewingOther && Scope.MeId == p.Id)">@p.Name</option> }
                </optgroup>
            }
        </select>
    </form>
}
