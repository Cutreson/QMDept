@model WorkTask
@* Leader / TP tự xác nhận việc của mình đã Hoàn thành hay Chưa hoàn thành (không qua duyệt — yêu cầu 2026-10-22). Chưa hoàn thành: ghi lý do hoặc chuyển sang ngày khác.
   Server kiểm lại ở StaffController.LeaderResult. Đặt NGOÀI mọi <form>. *@
@{
    var t = Model;
    var req = Context.Request;
    if (Scope.IsViewingOther || Scope.Account.Role == Role.Staff || t.EmployeeId != Scope.Account.Id || t.Date > Scope.Today || t.CarriedToId is not null) { return; }
    var asq = req.Query["as"].ToString();
    var asKv = ("as", asq.Length > 0 ? asq : null);
    var back = ("d", Fmt.Key(t.Date));
}
<div class="task-actions ro-ok" style="display:flex;justify-content:flex-end;align-items:center;gap:12px;margin:-2px 12px 6px">
    <form method="post" action="@Ui.To(req, "/Staff/LeaderResult", back, asKv)" asp-antiforgery="true" style="margin:0">
        @Ui.ReturnField(req)
        <input type="hidden" name="id" value="@t.Id"><input type="hidden" name="result" value="done">
        <button class="btn btn-sm@(t.Status == TaskState.Done ? " btn-primary" : "")">Hoàn thành</button>
    </form>
    <button type="button" class="btn btn-sm@(t.Status == TaskState.Late ? " btn-primary" : "")" data-sheet="lr@(t.Id)">Chưa hoàn thành</button>
</div>
<template id="lr@(t.Id)">
    <form class="ro-ok" method="post" action="@Ui.To(req, "/Staff/LeaderResult", back, asKv)">
        @Html.AntiForgeryToken()
        @Ui.ReturnField(req)
        <input type="hidden" name="id" value="@t.Id"><input type="hidden" name="result" value="notdone">
        <h3>Chưa hoàn thành</h3>
        <label class="f" for="lrN@(t.Id)" style="margin-top:0">Lý do</label>
        <input class="in" id="lrN@(t.Id)" name="note" maxlength="2000" value="@t.Note">
        <label class="f" for="lrD@(t.Id)">Chuyển sang ngày</label>
        @Ui.DateInput("to", null, "lrD" + t.Id)
        <div class="btn-row" style="margin-top:14px"><button type="button" class="btn" data-x="close">Hủy</button><button class="btn btn-primary">Lưu</button></div>
    </form>
</template>
