@model string
@* TP / Quản trị / Leader: tab "Trạng thái làm việc" gồm phần của chính mình — Trạng thái làm việc | ĐK làm thêm tại CTy (TP: yêu cầu 2026-10-21; Leader: gộp từ tab ĐK làm thêm riêng cùng ngày).
   TP: phần phê duyệt làm thêm nằm ở tab Phê duyệt (_MgrApprovalTabs). Model = mục đang mở: status | ot. (Leader không còn mục Tổng hợp suất ăn — yêu cầu 2026-10-21; Leader phụ trách nhân sự xem ở Tổng quan → Nhân sự phòng → Làm thêm tại công ty.) *@
@{
    var req = Context.Request;
    var items = new List<(string Href, string Label, bool Active)>
    {
        (Ui.To(req, "/Staff/Morning", ("as", "mine"), ("edit", null)), "Trạng thái làm việc", Model == "status"),
        (Ui.To(req, "/Overtime", ("tab", "mine"), ("edit", null), ("as", null)), "ĐK làm thêm tại CTy", Model == "ot"),
    };
}
@if (Scope.Account.Role == Role.Leader) { items.Insert(1, (Ui.To(req, "/Staff/Evening", ("as", "mine"), ("edit", null)), "Báo cáo cuối ngày", Model == "evening")); }
@Ui.Subtabs(items)
