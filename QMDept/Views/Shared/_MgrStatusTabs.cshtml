@model string
@* TP / Quản trị: tab "Trạng thái làm việc" chỉ gồm phần của chính mình — Trạng thái làm việc | ĐK làm thêm tại CTy (yêu cầu 2026-10-21).
   Phần phê duyệt làm thêm của Leader + tổng hợp suất ăn nằm ở tab Phê duyệt (_MgrApprovalTabs). Model = mục đang mở: status | ot. *@
@{
    var req = Context.Request;
}
@Ui.Subtabs(new List<(string Href, string Label, bool Active)>
{
    (Ui.To(req, "/Staff/Morning", ("as", "mine"), ("edit", null)), "Trạng thái làm việc", Model == "status"),
    (Ui.To(req, "/Overtime", ("tab", "mine"), ("edit", null), ("as", null)), "ĐK làm thêm tại CTy", Model == "ot"),
})
