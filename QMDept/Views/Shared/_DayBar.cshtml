@* dayBar(): chuyển ngày (?d=). Đổi ngày thì bỏ ?w=, ?m=, ?edit=, ?open= (giống artifact đặt S.week/S.month/S.editPlan/S.otEdit về mặc định). *@
@{
    var d = Scope.Date;
    var req = Context.Request;
    // Ngày khác đang có việc chờ xử lý (chấm đỏ) — yêu cầu 2026-10-22
    await D.EnsureAsync(Scope.Today.AddDays(-30), Scope.Today.AddDays(30));
    // Chỉ hiện ở các trang DUYỆT riêng (yêu cầu 2026-10-22): không hiện trên lịch hay trang khác
    var ctl = Context.GetRouteValue("controller")?.ToString() ?? ""; var act = Context.GetRouteValue("action")?.ToString() ?? "";
    var onApprove = (ctl == "Planning" && act is "Proposals" or "Leave" or "Reports" or "Support") || (ctl == "Manager" && act == "Approvals") || (ctl == "Overtime" && Context.Request.Query["tab"] == "approve");
    var pend = onApprove ? D.PendingDays(Scope.Account.Role, Scope.Account.Id).Where(x => x.Key != d).OrderBy(x => x.Key).Take(12).ToList() : [];
}
<div class="daybar">
    <a class="icon-btn" href="@Ui.Here(req, ("d", Fmt.Key(d.AddDays(-1))), ("w", null), ("m", null), ("edit", null), ("open", null))" aria-label="Ngày trước">‹</a>
    <span class="date">@Fmt.DayLabel(d)</span>
    @if (d != Scope.Today)
    {
        <a class="icon-btn" href="@Ui.Here(req, ("d", null), ("w", null), ("m", null), ("edit", null), ("open", null))">Hôm nay</a>
    }
    <a class="icon-btn" href="@Ui.Here(req, ("d", Fmt.Key(d.AddDays(1))), ("w", null), ("m", null), ("edit", null), ("open", null))" aria-label="Ngày sau">›</a>
</div>
@if (pend.Count > 0)
{
    <div class="pdays">
        <span class="note">Chờ xử lý ngày khác:</span>
        @foreach (var (pd, n) in pend)
        {
            <a class="pday" href="@Ui.Here(req, ("d", Fmt.Key(pd)), ("w", null), ("m", null), ("edit", null), ("open", null))">@Fmt.Dmy(pd) <b class="badge">@n</b></a>
        }
    </div>
}
