@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}
<section class="card sec" style="margin-top:16px">
    <h2>Đã có lỗi xảy ra</h2>
    <p>Không xử lý được yêu cầu. Vui lòng thử lại hoặc quay về <a class="link" href="/">trang chính</a>.</p>
    @if (Model.ShowRequestId)
    {
        <p class="note">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }
</section>
