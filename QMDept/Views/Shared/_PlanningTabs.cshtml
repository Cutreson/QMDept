@model string
@* Tiêu đề + tab con của Leader → Kế hoạch & duyệt (ldPlan). Model = khóa tab đang chọn: approvals|reports|week|projects|people|assign.
   Controller phải EnsureAsync(Date, Date) trước (để đếm báo cáo/đề xuất chuyển chờ duyệt). *@
@{
    var req = Context.Request;
    var d = Scope.Date;
    var reportCount = D.Reports.Count(r => r.Date == d && Dept.EodSt(r) == EodState.Pending && D.InScope(r.EmployeeId)) + D.CarriesFrom(d).Count(t => !t.CarryOk);
    var propCount = Scope.MeId is int pl ? D.ProposalsFor(pl).Count : 0;
    var tabs = new (string Key, string Path, string Label)[]
    {
        // Thứ tự theo yêu cầu 2026-10-16: Kế hoạch, Lịch tuần, Phân công, Báo cáo, Đề xuất lịch, Dự án & đầu mục, Leader dự án, Nhân sự.
        ("approvals", "/Planning/Approvals", "Kế hoạch"),
        ("week", "/Planning/Week", "Lịch tuần"),
        ("assign", "/Planning/Assign", "Phân công"),
        ("reports", "/Planning/Reports", "Báo cáo" + (reportCount > 0 ? $" ({reportCount})" : "")),
        ("proposals", "/Planning/Proposals", "Đề xuất lịch" + (propCount > 0 ? $" ({propCount})" : "")),
        ("projects", "/Planning/Projects", "Dự án & đầu mục"),
        ("leads", "/Planning/ProjectLeads", "Leader dự án"),
        ("people", "/Planning/People", "Nhân sự"),
    };
}
@Ui.Head(2, "Kế hoạch & phê duyệt")
@Ui.Subtabs(tabs.Select(t => (Ui.To(req, t.Path), t.Label, t.Key == Model)))
