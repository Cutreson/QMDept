@model string
@* Tiêu đề + tab con của Leader → Kế hoạch & duyệt (ldPlan). Model = khóa tab đang chọn: approvals|reports|week|projects|people|assign.
   Controller phải EnsureAsync(Date, Date) trước (để đếm báo cáo/đề xuất chuyển chờ duyệt). *@
@{
    var req = Context.Request;
    var d = Scope.Date;
    // Đếm theo TÀI KHOẢN Leader (không theo người đang xem): trang Kế hoạch tháng cũng dùng thanh tab này ở chế độ lịch nhóm / xem nhân viên.
    var lid = Scope.Account.Role == Role.Leader ? Scope.Account.Id : (int?)null;
    var inbox = lid is int li ? D.LeaderInbox(d, li) : 0;
    bool InTeam(int emp) => lid is int l ? D.P(emp) is { Role: Role.Staff } pe && pe.LeaderId == l : D.IsTeamStaff(emp);
    var reportCount = D.Reports.Count(r => r.Date == d && Dept.EodSt(r) == EodState.Pending && InTeam(r.EmployeeId));
    var propCount = lid is int pl ? D.ProposalsFor(pl).Count : Scope.MeId is int pm ? D.ProposalsFor(pm).Count : 0;
    var tabs = new (string Key, string Path, string Label)[]
    {
        // Thứ tự theo yêu cầu 2026-10-16 (sửa lại): Kế hoạch, Kế hoạch tháng (đã gồm giao việc → bỏ Lịch tuần + Phân công), Báo cáo, Đề xuất lịch, Dự án & đầu mục, Leader dự án, Nhân sự.
        // Gộp "Kế hoạch" + "Đề xuất lịch" + duyệt đăng ký làm thêm thành "Kế hoạch đề xuất" (yêu cầu 2026-10-19).
        ("month", "/Staff/Month?as=mine", "Kế hoạch tháng"),
        ("proposals", "/Planning/Proposals", "Kế hoạch đề xuất" + (inbox > 0 ? $" ({inbox})" : "")),
        ("reports", "/Planning/Reports", "Báo cáo" + (reportCount > 0 ? $" ({reportCount})" : "")),
        ("projects", "/Planning/Projects", "Dự án & đầu mục"),
        ("leads", "/Planning/ProjectLeads", "Leader dự án"),
        ("people", "/Planning/People", "Nhân sự"),
    };
}
@Ui.Head(2, "Kế hoạch & phê duyệt")
@Ui.Subtabs(tabs.Where(t => t.Key != "month" || Scope.Account.Role == Role.Leader).Select(t => (Ui.To(req, t.Path), t.Label, t.Key == Model)))
