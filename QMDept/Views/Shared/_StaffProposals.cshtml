@model StaffMonthVm
@* Đề xuất công việc của NV (yêu cầu 2026-10-15): dùng ở cả "Lịch của tôi" và "Lịch nhóm". Ngày = ngày đang chọn.
   Leader nhóm duyệt thì việc mới vào lịch. POST /Staff/ProposeCalendar (ở chế độ lịch của mình — Referer đưa NV về lại trang đang xem). *@
@{
    var me = Scope.Account;
    var sel = Scope.Date;
    var req = Context.Request;
}
@if (me.Role == Role.Staff && !Scope.IsViewingOther)
{
            @* Đề xuất lịch (yêu cầu 2026-10-15): thêm công việc của mình / người hỗ trợ cho dự án mình là Leader dự án — Leader nhóm duyệt mới ghi vào lịch *@
            var ledPj = D.Assigns.Where(a => a.EmployeeId == me.Id && a.Role == ProjectRole.Lead).Select(a => D.PJ(a.ProjectId)).OfType<Project>().Where(x => !x.Closed).ToList();
            var action = Ui.To(req, "/Staff/ProposeCalendar", ("d", Fmt.Key(sel)));
            <div class="row" style="gap:8px;margin:10px 0;flex-wrap:wrap">
                @if (me.LeaderId is not null && D.ActivePj().Count > 0) { <button type="button" class="btn btn-sm" data-sheet="propTask">＋ Đề xuất công việc</button> }
            </div>
                // Chỉ chỉ định được người trong nhóm của mình (NV cùng Leader + Leader của mình); nhóm khác / phòng ban chỉ xin theo số lượng.
                var cands = me.LeaderId is int gl
                    ? D.Active.Where(x => x.Id != me.Id && ((x.Role == Role.Staff && x.LeaderId == gl) || x.Id == gl)).OrderBy(x => x.Role).ThenBy(x => x.Name, Fmt.ViCompare).ToList()
                    : new List<Person>();
                var otherGroups = D.Leaders().Where(l => l.Id != me.LeaderId).ToList();
            <partial name="_ProposalSheet" model="@(new ProposalSheetVm { TemplateId = "propTask", Projects = D.ActivePj().OrderByDescending(p => ledPj.Any(l => l.Id == p.Id)).ToList(), People = cands, OtherGroups = otherGroups, LedProjectIds = ledPj.Select(x => x.Id).ToList(), Action = action })" />
            @if (Model.Proposals.Count > 0)
            {
                <section class="card sec"><h2>Đề xuất của tôi · @Fmt.Dm(sel)</h2>
                    @foreach (var x in Model.Proposals)
                    {
                        var who = x.People.Select(p => D.PName(p.EmployeeId)).ToList();   // người thực hiện (gồm cả người đề xuất nếu "Tôi thực hiện")
                        <div class="trow"><span class="ck @(x.Status == ExtraStatus.Approved ? "on" : "")">@(x.Status == ExtraStatus.Approved ? "✓" : "")</span>
                            <div><div class="t">@x.Title</div>
                                <div class="s">@D.PjName(x.ProjectId)@(who.Count > 0 ? " · Thực hiện: " + string.Join(", ", who) : "")@(string.IsNullOrEmpty(x.Departments) ? "" : " · Xin hỗ trợ: " + Fmt.QuotaText(x.Departments))@(x.Status == ExtraStatus.Rejected && !string.IsNullOrEmpty(x.Reason) ? " · Lý do: " + x.Reason : "")</div></div>
                            <span class="tm">@x.Start–@x.End <span class="pill @(x.Status == ExtraStatus.Approved ? "p-ok" : x.Status == ExtraStatus.Rejected ? "p-bad" : "p-warn")">@(x.Status == ExtraStatus.Approved ? "Đã duyệt" : x.Status == ExtraStatus.Rejected ? "Từ chối" : "Chờ duyệt")</span></span></div>
                    }
                </section>
            }
}
