@model string
@* Tiêu đề + tab con của Leader → Kế hoạch & duyệt (ldPlan). Model = khóa tab đang chọn: duyet|bc|tuan|da|ns|gv.
   Controller phải EnsureAsync(Date, Date) trước (để đếm báo cáo/đề xuất chuyển chờ duyệt). *@
@{
    var req = Context.Request;
    var d = Scope.Date;
    var bc = D.Reports.Count(r => r.Date == d && Dept.EodSt(r) == EodState.ChoDuyet && D.InScope(r.EmployeeId)) + D.CarriesFrom(d).Count(t => !t.CarryOk);
    var tabs = new (string Key, string Path, string Label)[]
    {
        ("duyet", "/KeHoach/Duyet", "Kế hoạch"),
        ("bc", "/KeHoach/BaoCao", "Báo cáo" + (bc > 0 ? $" ({bc})" : "")),
        ("tuan", "/KeHoach/Tuan", "Lịch tuần"),
        ("da", "/KeHoach/DuAn", "Dự án & đầu mục"),
        ("ns", "/KeHoach/NhanSu", "Nhân sự"),
        ("gv", "/KeHoach/PhanCong", "Phân công"),
    };
}
@Ui.Head(2, "Kế hoạch & phê duyệt", "Duyệt kế hoạch ngày, xếp lịch tuần, quản lý đầu mục")
@Ui.Subtabs(tabs.Select(t => (Ui.To(req, t.Path), t.Label, t.Key == Model)))
