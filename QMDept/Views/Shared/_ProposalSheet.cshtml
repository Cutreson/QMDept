@model ProposalSheetVm
@* Đề xuất công việc phát sinh của NV ở lịch tháng (yêu cầu 2026-10-15): <template> chứa form; mở bằng <button type="button" data-sheet="@Model.TemplateId">.
   Chỉ nội dung công việc (không chọn đầu mục) + giờ; xin người hỗ trợ: chỉ định người TRONG NHÓM MÌNH (ô chọn → thẻ ✕), xin theo số lượng cho
   từng phòng ban và nhóm khác; có lý do. POST /Staff/ProposeCalendar. Leader nhóm duyệt thì việc mới vào lịch. *@
@{
    var id = Model.TemplateId;
    var pid = Model.Projects.FirstOrDefault()?.Id;
}
<template id="@id">
    <form method="post" action="@Model.Action">
        @Html.AntiForgeryToken()
        @Ui.ReturnField(Context.Request)
        <h3>Đề xuất công việc</h3>
        <p class="note" style="margin:0 0 8px">@Fmt.WD[Fmt.Wday(Scope.Date)] @Fmt.Dm(Scope.Date)</p>
        <label class="f" for="@(id)P">Dự án</label>
        @Ui.Select("projectId", Model.Projects.Select(p => (p.Id.ToString(), p.Name)), pid?.ToString(), id: id + "P")
        <label class="f" for="@(id)T">Nội dung công việc phát sinh</label>
        <input class="in" id="@(id)T" name="title" maxlength="300">
        <div class="pick2 eq">
            <div><label class="f" for="@(id)S">Bắt đầu</label>@Ui.TimeSelect("start", "08:00", id: id + "S")</div>
            <div><label class="f" for="@(id)E">Kết thúc</label>@Ui.TimeSelect("end", "12:00", end: true, id: id + "E")</div>
        </div>
        <label class="f" for="@(id)Pick">Người hỗ trợ</label>
        <select class="in" id="@(id)Pick" data-pick-into="@(id)Chips" data-qty-row="@(id)Qty" data-nosearch>
            <option value="">— Chọn người / phòng ban / nhóm —</option>
            <optgroup label="Nhân sự trong nhóm của tôi">
                @foreach (var p in Model.People)
                {
                    <option value="@p.Id">@p.Name@(p.Role == Role.Leader ? " · Leader" : "")</option>
                }
            </optgroup>
            <optgroup label="Phòng ban (xin theo số lượng)">
                @for (var k = 0; k < Fmt.SupportDepartments.Length; k++)
                {
                    <option value="qd:@k">Phòng @Fmt.SupportDepartments[k]</option>
                }
            </optgroup>
            @if (Model.OtherGroups.Count > 0)
            {
                <optgroup label="Nhóm khác (xin theo số lượng)">
                    @foreach (var g in Model.OtherGroups)
                    {
                        <option value="qg:@g.Id">Nhóm @g.Name</option>
                    }
                </optgroup>
            }
        </select>
        @* Chọn phòng ban / nhóm khác → nhập số lượng rồi Thêm; xong lại chọn tiếp ở ô trên (site.js: pickPerson / addQty). *@
        <div id="@(id)Qty" class="row" style="gap:8px;margin-top:6px" hidden>
            <b class="qty-name" style="flex:1;min-width:0"></b>
            <label class="f" for="@(id)QtyN" style="margin:0">Số lượng</label>
            <input class="in" type="number" min="1" max="50" value="1" id="@(id)QtyN" style="width:84px">
            <button type="button" class="btn btn-primary btn-sm" data-qty-add>Thêm</button>
        </div>
        <div id="@(id)Chips" class="pick-chips"></div>
        <label class="f" for="@(id)R">Lý do xin người hỗ trợ</label>
        <textarea class="in" id="@(id)R" name="supportReason" maxlength="500"></textarea>
        <div class="btn-row" style="margin-top:14px"><button type="button" class="btn" data-x="close">Hủy</button>
            <button class="btn btn-primary">Gửi đề xuất</button></div>
    </form>
</template>
