@inject QMDept.Services.DevSwitch Dev
@inject QMDept.Services.ChromeBuilder CB
@{
    var chrome = await CB.BuildAsync();
    var toast = TempData["toast"] as string;
    var toastSticky = TempData["toastSticky"] as string;
    var hasSide = chrome is not null && chrome.Tabs.Count > 0;
    // Màn hình máy tính (≥1024px): các trang dạng "bảng điều khiển / danh sách thẻ" xếp thẻ thành 2 cột (xem site.css: main.grid-page).
    var page = $"{Context.GetRouteValue("controller")}/{Context.GetRouteValue("action")}";
    var gridPages = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "Leader/Overview", "Leader/Tracking", "Leader/Reports", "Manager/Approvals", "Manager/Reports",
        "Planning/Proposals", "Planning/Reports", "Planning/Projects", "Admin/Accounts",
    };
    var mainClass = "shell" + (gridPages.Contains(page) ? " grid-page" : "");
}
<!DOCTYPE html>
<html lang="vi" style="--accent:@(chrome?.Accent ?? "var(--brand)")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>@(ViewData["Title"] is string t ? t + " · " : "")Quản lý công việc phòng QLCL&amp;BD</title>
    <link rel="icon" href="~/favicon.ico" sizes="48x48" asp-append-version="true">
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true">
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true">
    <link rel="manifest" href="~/site.webmanifest">
    <meta name="theme-color" content="#1747d6">
    <meta name="apple-mobile-web-app-title" content="SORA QLCL">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600&display=swap">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(hasSide ? "has-side" : "no-side")@(Scope.Resolved && Scope.IsViewingOther ? " readonly" : "")" data-notify="@(chrome?.NotifyEnabled == true ? "1" : "0")">
@if (Dev.Enabled && chrome is not null)
{
    @* THANH DEV — chỉ hiện khi chạy thử trên máy (Development), không có trên web thật. Xem Services/DevSwitch.cs. *@
    var devPeople = await Dev.PeopleAsync();
    <div style="background:#fde68a;color:#1f2937;padding:6px 10px;font-size:12.5px;display:flex;flex-wrap:wrap;gap:6px 12px;align-items:center;position:sticky;top:0;z-index:60;border-bottom:1px solid #d97706">
        <b>DEV · chọn giao diện:</b>
        @foreach (var (role, label) in new[] { (Role.Staff, "Nhân viên"), (Role.Leader, "Leader"), (Role.Manager, "Trưởng phòng"), (Role.Admin, "Quản trị") })
        {
            var opts = devPeople.Where(p => p.Role == role).ToList();
            if (opts.Count == 0) { continue; }
            <form method="get" action="/Dev/As" style="display:flex;align-items:center;gap:4px;margin:0">
                <span>@label</span>
                <select class="in" name="id" data-autosubmit aria-label="Giao diện @label" style="padding:3px 22px 3px 6px;width:auto;font-size:12.5px;min-height:0">
                    @if (chrome.Account.Role != role) { <option value="" selected disabled hidden>— chọn —</option> }
                    @foreach (var p in opts)
                    {
                        <option value="@p.Id" selected="@(p.Id == chrome.Account.Id)">@p.Name · @p.Code</option>
                    }
                </select>
            </form>
        }
    </div>
}
@* Thanh trên. Điện thoại: logo + tài khoản / chọn giao diện / xem người (3 hàng). Máy tính: một hàng (site.css .top-grid). *@
<header class="top">
    <div class="shell top-grid">
        <a class="logo" href="/" style="text-decoration:none">SORA<small>Phòng QLCL&amp;BD</small></a>
        <div class="me" id="me">
            @if (chrome is not null)
            {
                <div class="acc"><b>@chrome.Account.Name @Ui.LevelPill(chrome.Account, false)</b><small><span class="mono">@chrome.Account.Code</span> · @chrome.AccountTeam</small></div>
                @Ui.Av(chrome.Account.Name, chrome.Account.Role == Role.Manager)
                <a class="btn btn-sm bell" href="/Inbox?as=me" title="Thông báo" aria-label="Thông báo">🔔<span class="bn" @(chrome.Unread > 0 ? null : "hidden")>@chrome.Unread</span></a>
                <a class="btn btn-sm" href="/Settings?as=me" title="Cài đặt thông báo" aria-label="Cài đặt">⚙</a>
                <form method="post" action="/Account/Logout" class="inline" asp-antiforgery="true"><button class="btn btn-sm" title="Đăng xuất">Thoát</button></form>
            }
        </div>
        @if (chrome is not null && !chrome.ViewInPlan && chrome.ViewOptions.Count > 0)   @* Leader không có hàng nút này: Kế hoạch tháng nằm trong tab Kế hoạch & duyệt (yêu cầu 2026-10-16) *@
        {
            @* Cấp trên chọn cấp dưới để xem màn hình của họ (chỉ xem) — xem ViewScope. *@
            <form method="get" action="@Context.Request.Path" class="row va viewas">
                @if (!string.IsNullOrEmpty(Context.Request.Query["d"])) { <input type="hidden" name="d" value="@Context.Request.Query["d"]"> }
                @if (!chrome.ViewInPlan)
                {
                <span class="note" style="white-space:nowrap">Xem màn hình:</span>
                <select class="in" name="as" data-autosubmit data-combo aria-label="Chọn người để xem màn hình">
                    @if (!chrome.ViewOptions.Any(o => o.Selected)) { <option value="" selected disabled hidden>Chọn người</option> }
                    @foreach (var g in chrome.ViewOptions.GroupBy(o => o.Group))
                    {
                        <optgroup label="@(g.Key ?? "Nhân sự")">
                            @foreach (var o in g) { <option value="@o.Value" selected="@o.Selected">@o.Label</option> }
                        </optgroup>
                    }
                </select>
                }
                <a class="btn btn-sm@(chrome.MineActive ? " btn-primary" : "")" href="@chrome.HomeHref" style="white-space:nowrap" aria-current="@(chrome.MineActive ? "page" : null)">Màn hình của tôi</a>
                @if (chrome.OwnHref is not null)
                {
                    <a class="btn btn-sm@(chrome.OwnActive ? " btn-primary" : "")" href="@chrome.OwnHref" style="white-space:nowrap" aria-current="@(chrome.OwnActive ? "page" : null)">@chrome.OwnLabel</a>
                }
                @if (chrome.TeamHref is not null)
                {
                    <a class="btn btn-sm@(chrome.TeamActive ? " btn-primary" : "")" href="@chrome.TeamHref" style="white-space:nowrap" aria-current="@(chrome.TeamActive ? "page" : null)">@chrome.TeamLabel</a>
                }
            </form>
        }
    </div>
</header>
<main class="@mainClass" id="app">
    @if (chrome is not null && chrome.ViewingName is not null)
    {
        <div class="notice ro-note" style="--nbg:var(--warn-soft);--nfg:var(--warn);margin-top:12px"><span class="ic">i</span><div>
            <b>Đang xem màn hình của @chrome.ViewingName — chỉ xem</b>
            <div class="note">@chrome.ViewingInfo · <a class="link" href="@chrome.HomeHref">Về màn hình của tôi ›</a></div>
        </div></div>
    }
    @if (chrome is not null && chrome.ViewingName is null)
    {
        foreach (var (rtext, rhref) in chrome.Reminders)
        {
            <div class="notice remind" style="--nbg:var(--warn-soft);--nfg:var(--warn);margin-top:12px"><span class="ic">!</span><div><b>@rtext</b> <a class="link" href="@rhref">Xử lý ngay ›</a></div></div>
        }
        @* Việc của CHÍNH Trưởng phòng / Quản trị chưa cập nhật: nhắc đỏ + liên kết tới đúng ngày để bấm "Cập nhật" (yêu cầu 2026-10-24) *@
        @if (chrome.OwnTodo.Count > 0)
        {
            <div class="notice ackbox" style="--nbg:var(--bad-soft);--nfg:var(--bad);margin-top:12px"><span class="ic">!</span><div>
                <b>Bạn còn @chrome.OwnTodo.Count việc của mình chưa cập nhật kết quả (Hoàn thành / chuyển sang ngày khác)</b>
                @foreach (var o in chrome.OwnTodo.Take(5))
                {
                    <div class="ack-row">
                        <div class="ack-main"><div class="ack-t">@o.Title</div>
                            <div class="note">@o.Project · @Fmt.Dmy(o.Date) @o.Start–@o.End</div></div>
                        <div class="ack-act"><a class="btn btn-sm btn-primary" href="/Staff/Morning?as=mine&d=@Fmt.Key(o.Date)">Cập nhật ngày @Fmt.Dm(o.Date)</a></div>
                    </div>
                }
                @if (chrome.OwnTodo.Count > 5) { <div class="note" style="margin-top:6px">… và @(chrome.OwnTodo.Count - 5) việc khác — cập nhật các việc trên để xem tiếp</div> }
            </div></div>
        }
        @* Việc MÌNH đã giao mà người nhận báo hoàn thành + gửi báo cáo: duyệt mới tính là xong (yêu cầu 2026-10-24) *@
        @if (chrome.DoneReviews.Count > 0)
        {
            <div class="notice ackbox" style="--nbg:var(--bad-soft);--nfg:var(--bad);margin-top:12px"><span class="ic">!</span><div>
                <b>@chrome.DoneReviews.Count việc bạn giao đã báo hoàn thành — chờ bạn duyệt</b>
                @foreach (var r in chrome.DoneReviews.Take(5))
                {
                    <div class="ack-row">
                        <div class="ack-main"><div class="ack-t">@r.Title@Html.Raw(Blocks.PriorityTag(r.Priority))</div>
                            <div class="note">@r.Employee · @r.Project · @Fmt.Dmy(r.Date) @r.Start–@r.End</div>
                            @if (!string.IsNullOrWhiteSpace(r.Note)) { <div class="note">Kết quả: @r.Note</div> }</div>
                        <div class="ack-act">
                            <form method="post" action="/Staff/ReviewDone?as=mine" asp-antiforgery="true" data-prompt="Chưa duyệt kết quả công việc" data-prompt-label="Lý do" data-prompt-required data-prompt-name="note">
                                @Ui.ReturnField(Context.Request)
                                <input type="hidden" name="id" value="@r.Id"><input type="hidden" name="v" value="no">
                                <button type="submit" class="btn btn-sm">Chưa đạt</button>
                            </form>
                            <form method="post" action="/Staff/ReviewDone?as=mine" asp-antiforgery="true">
                                @Ui.ReturnField(Context.Request)
                                <input type="hidden" name="id" value="@r.Id"><input type="hidden" name="v" value="ok">
                                <button type="submit" class="btn btn-sm btn-primary">Duyệt hoàn thành</button>
                            </form>
                        </div>
                    </div>
                }
                @if (chrome.DoneReviews.Count > 5) { <div class="note" style="margin-top:6px">… và @(chrome.DoneReviews.Count - 5) việc khác — duyệt các việc trên để xem tiếp</div> }
            </div></div>
        }
        @* Đề xuất lại nội dung / thời gian của việc MÌNH giao — người nhận đề xuất, mình duyệt lại (yêu cầu 2026-10-24) *@
        @if (chrome.ChangeReviews.Count > 0)
        {
            <div class="notice ackbox" style="--nbg:var(--bad-soft);--nfg:var(--bad);margin-top:12px"><span class="ic">!</span><div>
                <b>@chrome.ChangeReviews.Count việc bạn giao được người nhận đề xuất lại — chờ bạn duyệt</b>
                @foreach (var c in chrome.ChangeReviews.Take(5))
                {
                    <div class="ack-row">
                        <div class="ack-main"><div class="ack-t">@c.Employee · @c.Title@Html.Raw(Blocks.PriorityTag(c.Priority))</div>
                            <div class="note">Đang giao: @c.Project · @Fmt.Dmy(c.Date) @c.Start–@c.End</div>
                            <div class="note"><b>Đề xuất: @(c.NewTitle == c.Title ? "" : c.NewTitle + " · ")@Fmt.Dmy(c.NewDate) @c.NewStart–@c.NewEnd</b></div>
                            <div class="note">Lý do: @c.Reason</div></div>
                        <div class="ack-act">
                            <form method="post" action="/Staff/DecideChange?as=mine" asp-antiforgery="true" data-prompt="Không đồng ý đề xuất lại" data-prompt-label="Lý do" data-prompt-required data-prompt-name="note">
                                @Ui.ReturnField(Context.Request)
                                <input type="hidden" name="id" value="@c.Id"><input type="hidden" name="v" value="no">
                                <button type="submit" class="btn btn-sm">Không đồng ý</button>
                            </form>
                            <form method="post" action="/Staff/DecideChange?as=mine" asp-antiforgery="true">
                                @Ui.ReturnField(Context.Request)
                                <input type="hidden" name="id" value="@c.Id"><input type="hidden" name="v" value="ok">
                                <button type="submit" class="btn btn-sm btn-primary">Đồng ý</button>
                            </form>
                        </div>
                    </div>
                }
                @if (chrome.ChangeReviews.Count > 5) { <div class="note" style="margin-top:6px">… và @(chrome.ChangeReviews.Count - 5) đề xuất khác — xử lý các việc trên để xem tiếp</div> }
            </div></div>
        }
        @* Việc được giao đang chờ MÌNH xác nhận: liệt kê từng việc + nút Xác nhận ngay + liên kết tới ngày trong lịch (yêu cầu 2026-10-24) *@
        @if (chrome.AckTasks.Count > 0)
        {
            <div class="notice ackbox" style="--nbg:var(--bad-soft);--nfg:var(--bad);margin-top:12px"><span class="ic">!</span><div>
                <b>Bạn được giao @chrome.AckTasks.Count việc — cần xác nhận đã nhận việc</b>
                @foreach (var a in chrome.AckTasks.Take(5))
                {
                    <div class="ack-row">
                        <div class="ack-main"><div class="ack-t">@a.Title@Html.Raw(Blocks.PriorityTag(a.Priority))</div>
                            <div class="note">@a.Project · @Fmt.Dmy(a.Date) @a.Start–@a.End · Giao bởi @a.GivenBy</div></div>
                        <div class="ack-act">
                            <a class="btn btn-sm" href="@a.Href">Xem trong lịch</a>
                            <button type="button" class="btn btn-sm" data-sheet="rp@(a.Id)">Đề xuất lại</button>
                            <form method="post" action="/Staff/AckTask?id=@a.Id@(chrome.Account.Role == Role.Staff ? "" : "&as=mine")" asp-antiforgery="true">
                                @Ui.ReturnField(Context.Request)
                                <button type="submit" class="btn btn-sm btn-primary">Xác nhận đã nhận việc</button>
                            </form>
                        </div>
                    </div>
                }
                @if (chrome.AckTasks.Count > 5) { <div class="note" style="margin-top:6px">… và @(chrome.AckTasks.Count - 5) việc khác — <a class="link" href="@chrome.AckTasks[0].Href">xem trong lịch ›</a></div> }
            </div></div>
            foreach (var a in chrome.AckTasks.Take(5)) { <partial name="_TaskRepropose" model="(a.Id, a.Title, a.Date, a.Start, a.End)" /> }
        }
    }
    @RenderBody()
</main>
@* Điện thoại / máy tính bảng: thanh tab dưới đáy. Máy tính: menu dọc bên trái (site.css body.has-side .tabbar). *@
@if (hasSide)
{
    <nav class="tabbar" aria-label="Màn hình"><div class="shell">
        @foreach (var t in chrome!.Tabs)
        {
            <a href="@t.Href" aria-current="@(t.Active ? "page" : null)">@Ui.Icon(t.Icon)<span class="tl">@t.Label</span>@if (t.Badge > 0 || t.Wait > 0) {<span class="bgs">@if (t.Badge > 0) {<span class="badge">@t.Badge</span>}@if (t.Wait > 0) {<span class="badge wait" title="@t.Wait mục bạn đã đề xuất đang chờ duyệt" aria-label="@t.Wait mục đang chờ duyệt">@t.Wait</span>}</span>}</a>
        }
    </div></nav>
}
<div id="toast" class="toast" hidden role="status" data-msg="@toast" data-sticky="@(toastSticky is null ? null : "1")"></div>
<div id="notifs" class="notifs" aria-live="polite"></div>
<div id="dlg" class="dlg" hidden></div>
@if (chrome is not null)
{
    <script src="~/lib/microsoft-signalr/signalr.min.js" asp-append-version="true"></script>
}
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
