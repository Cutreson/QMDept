@model WorkTask
@* Xóa / Chuyển lịch một công việc (Leader / TP — yêu cầu 2026-10-20): hiện dưới dòng việc ở "Lịch của tôi" và "Lịch nhóm / phòng".
   Server kiểm quyền lại (StaffController.DeleteTask / MoveTask). Form .ro-ok để dùng được ở chế độ lịch nhóm (chỉ xem). *@
@{
    var t = Model;
    var req = Context.Request;
    var acc = Scope.Account;
    var emp = D.P(t.EmployeeId);
    if (!Scope.CanLead || !StaffCalendar.OwnsTask(acc, Scope.IsManager, Scope.IsViewingOther, emp, t) || StaffCalendar.TaskLocked(D, t)) { return; }
    var asq = req.Query["as"].ToString();
    var back = ("d", Fmt.Key(t.Date));
    var asKv = ("as", asq.Length > 0 ? asq : null);
    // Người nhận khi chuyển lịch: mình + người thuộc quyền (Leader: nhân viên nhóm; TP / Quản trị: Leader).
    var pool = new List<Person> { acc };
    pool.AddRange(acc.Role == Role.Leader ? D.Team(acc.Id) : D.Leaders());
    pool = pool.GroupBy(p => p.Id).Select(g => g.First()).ToList();
    var canMove = t.CarriedFromId is null && t.CarriedToId is null;
}
<div class="task-actions ro-ok" style="display:flex;justify-content:flex-end;gap:14px;margin:-2px 12px 6px">
    @if (canMove) { <button type="button" class="link ro-ok" data-sheet="mv@(t.Id)">Chuyển lịch</button> }
    <form method="post" action="@Ui.To(req, "/Staff/DeleteTask", back, asKv)" asp-antiforgery="true" class="inline ro-ok" data-confirm="Xóa “@t.Title” khỏi lịch?" data-confirm-label="Xóa">
        @Ui.ReturnField(req)
        <input type="hidden" name="id" value="@t.Id">
        <button class="link" style="color:var(--bad)">Xóa</button>
    </form>
</div>
@if (canMove)
{
    <template id="mv@(t.Id)">
        <form class="ro-ok" method="post" action="@Ui.To(req, "/Staff/MoveTask", back, asKv)">
            @Html.AntiForgeryToken()
            @Ui.ReturnField(req)
            <input type="hidden" name="id" value="@t.Id">
            <h3>Chuyển công việc sang lịch khác</h3>
            <p class="note" style="margin:0 0 8px"><b>@t.Title</b> · @D.PjName(t.ProjectId) · @t.Start–@t.End<br>Hiện ở lịch của @D.PName(t.EmployeeId) ngày @Fmt.Dmy(t.Date)</p>
            <label class="f" for="mvD@(t.Id)" style="margin-top:0">Chuyển đến ngày</label>
            @Ui.DateInput("to", t.Date < Scope.Today ? Scope.Today : t.Date, "mvD" + t.Id)
            <label class="f" for="mvE@(t.Id)">Lịch của</label>
            @Ui.Select("emp", pool.Select(p => (p.Id.ToString(), p.Id == acc.Id ? p.Name + " (tôi)" : p.Name)), t.EmployeeId.ToString(), id: "mvE" + t.Id)
            <div class="btn-row" style="margin-top:14px"><button type="button" class="btn" data-x="close">Hủy</button><button class="btn btn-primary">Chuyển lịch</button></div>
        </form>
    </template>
}
