@model WorkTask
@* Sheet Sửa + form Xóa (người giao / quyền quản lý), sheet "Đề xuất lại" (người nhận việc do người khác giao) hoặc sheet "Cập nhật" (Trưởng phòng / Quản trị tự quản lý việc của mình) — yêu cầu 2026-10-20, 2026-10-21, 2026-10-24.
   Nút nằm ở cột cuối dòng việc (_TaskBtns). Server kiểm quyền lại (StaffController.EditTask / DeleteTask / ProposeChange / UpdateOwnTask). *@
@{
    var t = Model;
}
@if (StaffCalendar.CanSelfUpdate(Scope, t))
{
    <partial name="_SelfUpdate" model="t" />
}
@if (StaffCalendar.CanManage(Scope, D, t))
{
    <partial name="_TaskEdit" model="t" />
}
else if (StaffCalendar.CanRepropose(Scope, D, t))
{
    <partial name="_TaskRepropose" model="(t.Id, t.Title, t.Date, t.Start, t.End)" />
}
