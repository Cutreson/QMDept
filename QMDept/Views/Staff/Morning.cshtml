@model StaffMorningVm
@* nvMorning (Báo cáo đầu ngày). Controller: StaffController.Reports.cs (Morning / SubmitPlan / AddUnplannedTask).
   Hộp thoại chọn giờ nghỉ, bỏ chọn việc trùng giờ nghỉ, bản nháp form: wwwroot/js/staff.js (openLeave, applyLeave, onStatusChange, saveDraft). *@
@{
    ViewData["Title"] = "Báo cáo đầu ngày";
    var req = Context.Request;
    var d = Scope.Date;
    var dkey = Fmt.Key(d);
    var ro = Scope.IsReadOnly;
    var me = Model.Me;
    var plan = Model.Plan;
    // Leader (chế độ cá nhân ?as=mine): trang này chỉ khai báo "Trạng thái làm việc trong ngày" + báo cơm (yêu cầu 2026-10-16), không có việc / hỗ trợ / báo cáo cuối ngày
    var lead = me is not null && me.Role is Role.Leader or Role.Manager or Role.Admin;
    var selfOk = me is not null && me.Role is Role.Manager or Role.Admin;   // TP / Quản trị: không có người duyệt, trạng thái tự được duyệt (yêu cầu 2026-10-21)
    if (lead) ViewData["Title"] = "Trạng thái làm việc";
}
@section Scripts {
    <script src="~/js/staff.js" asp-append-version="true"></script>
}
@Ui.Head(3, lead ? "Trạng thái làm việc trong ngày" : "Báo cáo đầu ngày")
@if (selfOk)
{
    <partial name="_MgrStatusTabs" model="@("status")" />
}
<partial name="_DayBar" />
@if (me is null)
{
    return;
}
@if (D.OnLeave(d, me.Id) is { } onLeave)
{
    <div class="notice" style="--nbg:var(--idle-soft);--nfg:var(--idle)"><span class="ic">i</span><div><b>Bạn được ghi nghỉ ngày này</b><div class="note">@(onLeave.Reason ?? "")</div></div></div>
}
@if (!ro)
{
    <script id="staffCfg" type="application/json">@Html.Raw(StaffReports.MorningCfg(d, me.Id, clear: !Model.ShowForm))</script>
}

@if (!Model.ShowForm && plan is not null)
{
    // ---------- Đã gửi: trạng thái kế hoạch ----------
    var st = Dept.PlanSt(plan);
    var sel = D.Chosen(d, me.Id);
    var needsManager = Dept.NeedsManager(plan);
    if (st == PlanState.Rejected)
    {
        <div class="notice" style="--nbg:var(--bad-soft);--nfg:var(--bad)"><span class="ic">!</span><div><b>@(lead ? "Trạng thái làm việc bị từ chối" : "Kế hoạch bị từ chối")</b></div></div>
    }
    else
    {
        <div class="notice"><span class="ic">✓</span><div><b>Đã gửi @(lead ? "trạng thái làm việc" : "kế hoạch") lúc @VnTime.Hm(plan.SentAt)</b></div></div>
    }
    <section class="card sec">
        <h2>Công việc đã chọn (@sel.Count)</h2>
        @if (sel.Count > 0)
        {
            foreach (var t in sel)
            {
                @D.TaskRow(t)
                @if (lead) { <partial name="_TaskActions" model="t" /> }
            }
        }
        else
        {
            <p class="note">Không chọn việc nào.</p>
        }
        @if (!string.IsNullOrEmpty(plan.Note))
        {
            <div class="cmt" style="margin-top:10px"><b>Ghi chú / yêu cầu hỗ trợ:</b> @plan.Note</div>
        }
        @Html.Raw(Blocks.SupCmt(plan, string.IsNullOrEmpty(plan.Note) ? "margin-top:10px" : ""))
    </section>
    <section class="card sec">
        <h2>Trạng thái &amp; báo cơm</h2>
        <div class="kv2">
            <div><div class="note">Trạng thái</div><span class="pill @(LeaveRules.IsLeave(plan.Status) ? "p-warn" : "p-info")">@Labels.Of(plan.Status)</span></div>
            <div><div class="note">Báo cơm</div><span class="pill p-info">@Labels.Of(plan.Meal)</span></div>
        </div>
        @if (LeaveRules.IsLeave(plan.Status) && plan.LeaveType is not null)
        {
            <div class="leave-line">Thời gian nghỉ: @Html.Raw(Blocks.LeaveText(plan))</div>
        }
        @if (LeaveRules.IsTrip(plan.Status) && (plan.TripProvince is not null || plan.TripCustomer is not null))
        {
            <div class="leave-line">Địa điểm công tác: <b>@(plan.TripProvince ?? "—")</b> · Khách hàng: <b>@(plan.TripCustomer ?? "—")</b></div>
        }
    </section>
    @if (!selfOk)
    {
    <section class="card sec">
        <h2>Trạng thái duyệt</h2>
        <div class="trow">@StaffReports.DecisionCk(plan.LeaderDecision)<div class="t">@(me.Role == Role.Leader ? "Trưởng phòng" : "Leader")</div><span>@StaffReports.DecisionCell(plan.LeaderDecision, plan.LeaderAt, "<span class=\"pill p-warn\">Chờ duyệt</span>")</span></div>
        @if (needsManager && me.Role != Role.Leader)
        {
            <div class="trow">@StaffReports.DecisionCk(plan.ManagerDecision)<div class="t">Trưởng phòng <span class="note">(hỗ trợ nhân sự)</span></div><span>@StaffReports.DecisionCell(plan.ManagerDecision, plan.ManagerAt, plan.LeaderDecision == Decision.Ok ? "<span class=\"pill p-warn\">Chờ duyệt</span>" : "<span class=\"pill p-idle\">Sau Leader</span>")</span></div>
        }
        @if (!string.IsNullOrEmpty(plan.LeaderNote))
        {
            <div class="cmt" style="margin-top:10px"><b>@(string.IsNullOrEmpty(plan.LeaderBy) ? (me.Role == Role.Leader ? "Trưởng phòng" : "Leader") : plan.LeaderBy) · @(me.Role == Role.Leader ? "Trưởng phòng" : "Leader"):</b> @plan.LeaderNote</div>
        }
        @if (!string.IsNullOrEmpty(plan.ManagerNote))
        {
            <div class="cmt"><b>@(string.IsNullOrEmpty(plan.ManagerBy) ? "Trưởng phòng" : plan.ManagerBy) · TP:</b> @plan.ManagerNote</div>
        }
        @if (st != PlanState.Approved && !ro)
        {
            <a class="btn btn-ghost btn-block" href="@Ui.Here(req, ("edit", dkey))" style="margin-top:6px">@(lead ? "Sửa trạng thái và gửi lại" : "Sửa kế hoạch và gửi lại")</a>
        }
    </section>
    }
    else if (!ro)
    {
        <a class="btn btn-ghost btn-block" href="@Ui.Here(req, ("edit", dkey))">Sửa trạng thái và gửi lại</a>
    }
    @if (!lead)
    {
        <a class="btn btn-primary btn-block" href="@Ui.To(req, "/Staff/Evening")">Tiếp: Báo cáo cuối ngày ›</a>
    }
    return;
}

@{
    // ---------- Form gửi kế hoạch (chưa gửi / đang sửa) ----------
    var f = Model.Form;
    var leaveNow = f.LeaveNow;
    var isLeave = f.Status is WorkStatus w0 && LeaveRules.IsLeave(w0);
    var isTrip = f.Status is WorkStatus w1 && LeaveRules.IsTrip(w1);
    var dis = ro ? "disabled" : null;
}
<form id="planForm" method="post" action="@Ui.To(req, "/Staff/SubmitPlan", ("d", dkey))" asp-antiforgery="true" data-ro="@(ro ? "1" : "0")">
    @Ui.ReturnField(req)
    <section class="card sec">
        <h2>1. Nội dung công việc</h2>
        @if (Model.List.Count > 0)
        {
            foreach (var t in Model.List)
            {
                var src = Labels.Of(t.Source);
                var hit = leaveNow is not null && LeaveRules.Overlaps(t, leaveNow.From, leaveNow.To);
                <label class="trow"><input type="checkbox" name="picks" value="@t.Id" data-start="@t.Start" data-end="@t.End" data-place="@D.PJ(t.ProjectId)?.Location" data-customer="@D.PJ(t.ProjectId)?.Factory" checked="@Model.IsOn(t)" disabled="@ro"><div><div class="t">@t.Title</div><div class="s">@D.PjName(t.ProjectId)@(src.Length > 0 ? " · " + src : "")<span data-leave-hit hidden="@(!hit)"> · <span class="warn-t">Trùng giờ nghỉ</span></span></div></div><span class="tm">@t.Start – @t.End</span>@if (lead && StaffCalendar.CanManage(Scope, D, t)) { <span class="row" style="gap:10px;margin-left:8px"><button type="button" class="link" data-sheet="et@(t.Id)">Sửa</button><button type="submit" class="link" form="dt@(t.Id)" style="color:var(--bad)">Xóa</button></span> }</label>
            }
        }
        else
        {
            <p class="note">Chưa có việc trong lịch tuần.</p>
        }
        @if (!ro)
        {
            <button type="button" class="link" data-sheet="tplAddOut" style="margin-top:10px">＋ Thêm công việc ngoài kế hoạch</button>
        }
        @if (!lead)
        {
        @* Nhân sự hỗ trợ — cùng thiết kế với "Đề xuất công việc" ở lịch tháng: ô chọn người trong nhóm / phòng ban / nhóm khác (số lượng) → thẻ ✕;
           lý do bên dưới. JSON lựa chọn nằm ở #pSupportPick; phạm vi (#pSupport) do staff.js / máy chủ suy ra. *@
            var supGid = me.Role == Role.Leader ? me.Id : me.LeaderId;   // Leader: chỉ định được NV trong nhóm của chính mình
            var supCands = supGid is int sgl
                ? D.Active.Where(x => x.Id != me.Id && ((x.Role == Role.Staff && x.LeaderId == sgl) || (x.Id == sgl && me.Role != Role.Leader))).OrderBy(x => x.Role).ThenBy(x => x.Name, Fmt.ViCompare).ToList()
                : new List<Person>();
            var supGroups = D.Leaders().Where(l => l.Id != supGid && l.Id != me.Id).ToList();
        <label class="f" for="pSupportPicker" style="margin-top:14px">Nhân sự hỗ trợ</label>
        <input type="hidden" id="pSupport" name="support" value="@f.Support">
        <input type="hidden" id="pSupportPick" name="supportPick" value="@f.SupportPick">
        @if (!ro)
        {
            <select class="in" id="pSupportPicker" data-pick-into="pSupChips" data-qty-row="pSupQty" data-nosearch>
                <option value="">— Không cần hỗ trợ / chọn người, phòng ban, nhóm —</option>
                <optgroup label="Nhân sự trong nhóm của tôi (Leader duyệt)">
                    @foreach (var p in supCands)
                    {
                        <option value="@p.Id">@p.Name@(p.Role == Role.Leader ? " · Leader" : "")</option>
                    }
                </optgroup>
                <optgroup label="Phòng ban (xin theo số lượng, cần thêm TP duyệt)">
                    @for (var k = 0; k < Fmt.SupportDepartments.Length; k++)
                    {
                        <option value="qd:@k">Phòng @Fmt.SupportDepartments[k]</option>
                    }
                </optgroup>
                @if (supGroups.Count > 0)
                {
                    <optgroup label="Nhóm khác (xin theo số lượng, cần thêm TP duyệt)">
                        @foreach (var g in supGroups)
                        {
                            <option value="qg:@g.Id">Nhóm @g.Name</option>
                        }
                    </optgroup>
                }
            </select>
            <div id="pSupQty" class="row" style="gap:8px;margin-top:6px" hidden>
                <b class="qty-name" style="flex:1;min-width:0"></b>
                <label class="f" for="pSupQtyN" style="margin:0">Số lượng</label>
                <input class="in" type="number" min="1" max="50" value="1" id="pSupQtyN" style="width:84px">
                <button type="button" class="btn btn-primary btn-sm" data-qty-add>Thêm</button>
            </div>
            <div id="pSupChips" class="pick-chips"></div>
        }
        else if (f.Support != SupportScope.None)
        {
            <p class="note" style="margin:0">@f.SupportText</p>
        }
        <div id="supportWrap" hidden="@(f.Support == SupportScope.None)"><label class="f" for="pSupportText">Lý do xin người hỗ trợ</label><textarea class="in" id="pSupportText" name="supportText" maxlength="1500" disabled="@ro">@f.SupportText</textarea></div>
        <label class="f" for="pNote">Ghi chú (nếu có)</label><textarea class="in" id="pNote" name="note" maxlength="2000" disabled="@ro">@f.Note</textarea>
        }
        else
        {
            @* staff.js vẫn đọc các ô này → giữ ô ẩn (Leader không có hỗ trợ / ghi chú — yêu cầu 2026-10-16) *@
            <input type="hidden" id="pSupport" name="support" value="None">
            <input type="hidden" id="pSupportPick" name="supportPick" value="">
            <textarea id="pNote" name="note" hidden></textarea>
            <div id="supportWrap" hidden><textarea id="pSupportText" name="supportText" hidden></textarea></div>
        }
    </section>
    <section class="card sec">
        <h2>2. Trạng thái &amp; báo cơm</h2>
        <div class="pick2">
            <div><label class="f" for="pStatus" style="margin-top:0">Trạng thái làm việc</label>@Ui.Select("status", Ui.EnumOpts<WorkStatus>(), f.Status?.ToString(), "Chọn trạng thái…", id: "pStatus", extraAttrs: dis)</div>
            <div><label class="f" for="pMeal" style="margin-top:0">Báo cơm</label>@Ui.Select("meal", Ui.EnumOpts<Meal>(), f.Meal?.ToString(), "Chọn…", id: "pMeal", extraAttrs: dis)</div>
        </div>
        <div id="leaveWrap" hidden="@(!isLeave)">@if (isLeave)
            {
                @StaffReports.LeaveBox(f.Status!.Value, leaveNow, ro)
            }</div>
        <input type="hidden" name="leaveType" value="@(f.Leave?.Type.ToString())">
        <input type="hidden" name="leaveSession" value="@(f.Leave?.Session?.ToString())">
        <input type="hidden" name="leaveFrom" value="@(f.Leave?.From)">
        <input type="hidden" name="leaveTo" value="@(f.Leave?.To)">
        @* Công tác: địa điểm + khách hàng tự lấy theo dự án của các việc đã chọn (staff.js đổ vào #tripInfo; máy chủ ghi lại khi gửi) — NV không phải chọn (yêu cầu 2026-10-16). *@
        <div class="leave-line" id="tripWrap" style="margin-top:10px" hidden="@(!isTrip)">Địa điểm công tác: <b id="tripPlace"></b> · Khách hàng: <b id="tripCustomer"></b></div>
    </section>
    @if (!ro)
    {
        <button class="btn btn-primary btn-block">@(lead ? "Gửi trạng thái làm việc" : "Gửi kế hoạch đầu ngày")</button>
        if (Model.Editing)
        {
            <a class="btn btn-block" href="@Ui.Here(req, ("edit", null))" style="margin-top:8px">Hủy sửa</a>
        }
    }
</form>
@if (lead) { foreach (var t in Model.List) { <partial name="_TaskEdit" model="t" /> } }

@if (!ro)
{
    @* addTaskFields('o', mainProject(me, d)) + addOut: form riêng trong bảng trượt (không lồng trong planForm). *@
    <template id="tplAddOut">
        <form method="post" action="@Ui.To(req, "/Staff/AddUnplannedTask", ("d", dkey))">
            @Html.AntiForgeryToken()
            @Ui.ReturnField(req)
            <h3>Thêm công việc ngoài kế hoạch</h3>
            <partial name="_TaskFields" model="@(new TaskFieldsVm { Prefix = "o", ProjectId = D.MainProject(me.Id, d), ShowItem = false })" />
            <div class="btn-row" style="margin-top:14px"><button type="button" class="btn" data-x="close">Hủy</button><button class="btn btn-primary">Thêm vào danh sách</button></div>
        </form>
    </template>
    <partial name="_ItemsJson" />
}
