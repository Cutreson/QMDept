@model StaffEveningVm
@* nvEvening (Báo cáo cuối ngày). Controller: StaffController.Reports.cs (Evening / UpdateTask / ProposeExtra / SubmitReport).
   Sheet "Cập nhật công việc" (openUpdate) = <template id="upd{id}">; hành vi trong sheet (ẩn kế hoạch tiếp, nhãn lý do,
   tự tích đầu mục) ở wwwroot/js/staff.js. *@
@{
    ViewData["Title"] = "Báo cáo cuối ngày";
    var req = Context.Request;
    var d = Scope.Date;
    var dkey = Fmt.Key(d);
    var ro = Scope.IsReadOnly;
    var me = Model.Me;
}
@section Scripts {
    <script src="~/js/staff.js" asp-append-version="true"></script>
}
@Ui.Head(4, "Báo cáo cuối ngày")
@if (Scope.Account.Role == Role.Leader && Scope.OwnCalendar) { <partial name="_MgrStatusTabs" model="@("evening")" /> }
<partial name="_DayBar" />
@if (me is null)
{
    return;
}
@{
    var plan = D.PlanOf(d, me.Id);
    var list = D.Chosen(d, me.Id);
    var xs = D.ExtrasOn(d).Where(x => x.EmployeeId == me.Id).ToList();
    var rep = D.ReportOf(d, me.Id);
    // Báo cáo đã gửi (chờ duyệt) hoặc đã duyệt → khóa chỉnh sửa; Leader từ chối → mở lại để cập nhật theo yêu cầu (yêu cầu 2026-10-20)
    var es0 = Dept.EodSt(rep);
    var locked = rep is not null && es0 != EodState.Rejected;
    ro = ro || locked;
    // Dự án đã có Leader dự án: người hỗ trợ chỉ tích "Đã hỗ trợ"; Leader dự án báo cáo cả việc của người hỗ trợ trong dự án mình phụ trách.
    var teamTasks = D.TeamTasksOf(me.Id, d);
    var openCnt = list.Count(t => !D.IsSupportTask(t) && t.Status != TaskState.Done && t.CarriedToId is null);
    var teamOpen = teamTasks.Count(t => t.Status != TaskState.Done && t.CarriedToId is null);
    var supCnt = list.Count(t => D.IsSupportTask(t) && !t.Supported);
}
@if (plan is null)
{
    <div class="notice" style="--nbg:var(--warn-soft);--nfg:var(--warn)"><span class="ic">!</span><div><b>Chưa gửi kế hoạch đầu ngày</b><div class="note"><a class="link" href="@Ui.To(req, "/Staff/Morning")">Đi tới Báo cáo đầu ngày ›</a></div></div></div>
}
else if (Dept.PlanSt(plan) != PlanState.Approved)
{
    <p class="note">Trạng thái kế hoạch: @Ui.Pill(Dept.PlanSt(plan))</p>
}
@{
    // Việc phải làm ở ngày này, ghi rõ để người dùng biết cần xử lý gì (yêu cầu 2026-10-24): hiện khi báo cáo chưa gửi / bị yêu cầu bổ sung, ngày đã qua hoặc từ 17:00.
    var needReport = !Scope.IsViewingOther && (rep is null || es0 == EodState.Rejected) && (list.Count > 0 || teamTasks.Count > 0)
        && (plan is not null && !LeaveRules.IsLeave(plan.Status)) && (d < Scope.Today || string.CompareOrdinal(VnTime.NowHm, "17:00") >= 0);
}
@if (needReport)
{
    <div class="notice" style="--nbg:var(--bad-soft);--nfg:var(--bad)"><span class="ic">!</span><div><b>@Fmt.DayLabel(d): cần làm để gửi báo cáo cuối ngày</b>
        <div class="note" style="color:var(--bad)">
            @if (supCnt > 0) { <div>• @supCnt việc hỗ trợ chưa tích “Đã hỗ trợ”</div> }
            @if (openCnt > 0) { <div>• @openCnt việc chưa hoàn thành: bấm Cập nhật, ghi lý do và chọn ngày chuyển sang (sau hôm nay)</div> }
            @if (teamOpen > 0) { <div>• @teamOpen việc của dự án bạn phụ trách chưa báo hoàn thành hay kế hoạch tiếp theo</div> }
            <div>• Bấm <b>Gửi báo cáo cuối ngày</b> ở cuối trang (<a class="link" href="#eodForm">đi tới nút gửi</a>)</div>
        </div></div></div>
}
@if (rep is not null)
{
    var es = Dept.EodSt(rep);
    var by = string.IsNullOrEmpty(rep.LeaderBy) ? (me.Role == Role.Leader ? "Trưởng phòng" : "Leader") : rep.LeaderBy;
    if (es == EodState.Rejected)
    {
        <div class="notice" style="--nbg:var(--bad-soft);--nfg:var(--bad)"><span class="ic">!</span><div><b>@by yêu cầu bổ sung báo cáo</b><div class="note">@(rep.LeaderNote ?? "")</div></div></div>
    }
    else if (es == EodState.Approved)
    {
        <div class="notice"><span class="ic">✓</span><div><b>@by đã duyệt báo cáo lúc @VnTime.Stamp(rep.LeaderAt)</b>@if (!string.IsNullOrEmpty(rep.LeaderNote))
            {
                <div class="note">Góp ý: @rep.LeaderNote</div>
            }</div></div>
        @if (rep.LeaderBy == "Tự xác nhận" && !Scope.IsReadOnly)
        {
            <form method="post" action="@Ui.To(req, "/Staff/WithdrawReport", ("d", dkey))" asp-antiforgery="true" class="inline" data-confirm="Rút lại báo cáo để sửa? Báo cáo sẽ chưa được gửi cho đến khi bạn gửi lại." data-confirm-label="Rút lại">
                @Ui.ReturnField(req)
                <button class="btn btn-sm" style="margin-bottom:10px">Rút lại để sửa</button>
            </form>
        }
    }
    else
    {
        <div class="notice" style="--nbg:var(--warn-soft);--nfg:var(--warn)"><span class="ic">✓</span><div><b>Đã gửi báo cáo lúc @VnTime.Stamp(rep.SentAt) · chờ @(me.Role == Role.Leader ? "Trưởng phòng" : "Leader") duyệt</b></div></div>
        @if (!Scope.IsReadOnly)
        {
            <form method="post" action="@Ui.To(req, "/Staff/WithdrawReport", ("d", dkey))" asp-antiforgery="true" class="inline" data-confirm="Rút lại báo cáo để sửa? Leader sẽ không còn thấy báo cáo này cho đến khi bạn gửi lại." data-confirm-label="Rút lại">
                @Ui.ReturnField(req)
                <button class="btn btn-sm" style="margin-bottom:10px">Rút lại để sửa</button>
            </form>
        }
    }
}
@if (rep is not null && locked)
{
    @* Báo cáo tổng hợp theo dự án: chờ duyệt thì chỉ xem; Leader duyệt xong thì chọn / sao chép gửi nhóm Zalo của từng dự án (yêu cầu 2026-10-20) *@
    var sum = EodText.Build(D, d, me, rep);
    var approved = es0 == EodState.Approved;
    var allIds = "eodHead " + string.Join(" ", sum.Projects.Select((_, i) => "eodP" + i)) + " eodFoot";
    <section class="card sec" id="eodSummary">
        <div class="row" style="justify-content:space-between;align-items:center;gap:8px"><h2 style="margin:0">Báo cáo tổng hợp</h2><span class="pill @(approved ? "p-ok" : "p-warn")">@(approved ? "Đã duyệt" : "Chờ duyệt")</span></div>
        <pre class="rpt-text" id="eodHead">@sum.Header</pre>
        @for (var i = 0; i < sum.Projects.Count; i++)
        {
            <div class="rpt-blk"><pre class="rpt-text" id="@("eodP" + i)">@sum.Projects[i].Text</pre>
                @if (approved) { <button type="button" class="btn btn-sm" data-copy="@("eodHead eodP" + i)">Sao chép dự án này</button> }</div>
        }
        <pre class="rpt-text" id="eodFoot">@sum.Footer</pre>
        @if (approved) { <button type="button" class="btn btn-primary btn-block" data-copy="@allIds" style="margin-top:8px">Sao chép toàn bộ báo cáo</button> }
    </section>
}
<div class="h2">Kết quả công việc hôm nay</div>
@if (list.Count > 0)
{
    <ul class="tl">
        @foreach (var t in list)
        {
            var st = t.Status;
            var src = Blocks.SrcOf(t);
            var open = Model.Open.Contains(t.Id);
            var n = st != TaskState.Done ? D.Task(t.CarriedToId) : null;
            var sup = D.IsSupportTask(t);
            var lead = D.ProjectLead(t.ProjectId);
            <li id="t@(t.Id)"><span class="dot" style="--nc:@Labels.Color(st)">@(st == TaskState.Done ? "✓" : "")</span><div class="card task">
                <div class="h"><div><div class="t">@t.Title</div>@if (src.Length > 0)
                    {
                        <div class="src">@src</div>
                    }</div>@if (sup)
                    {
                        <span class="pill @(t.Supported ? "p-ok" : "p-warn")">@(t.Supported ? "Đã hỗ trợ" : "Chưa tích hỗ trợ")</span>
                    }
                    else
                    {
                        @Ui.Pill(st)
                    }</div>
                <div class="tm">@t.Start – @t.End</div>
                <partial name="_DoneReview" model="t" />
                @if (D.PJ(t.ProjectId) is not { IsCommon: true }) { <div class="note" style="margin:0 0 6px">@(sup ? "Bạn hỗ trợ" : "Leader dự án"): <b>@(lead is null ? "chưa chọn Leader dự án" : lead.Id == me.Id ? "Bạn" : lead.Name)</b></div> }
                @if (n is not null)
                {
                    <div class="nx-line">Kế hoạch tiếp: <b>@Fmt.Short(n.Date)</b> <span class="mono">@(n.Start)–@(n.End)</span> · @n.Title<div class="note">@(D.OkCal(n) ? D.ApproverName(D.P(n.EmployeeId)) + " đã duyệt, đã vào lịch" : "Đề xuất, chờ " + D.ApproverName(D.P(n.EmployeeId)) + " duyệt")@(string.IsNullOrEmpty(n.EditedBy) ? "" : " · " + n.EditedBy + " đã chỉnh")</div></div>
                }
                @if (t.Source == TaskSource.CarryOver && t.FromDate is DateOnly fd)
                {
                    <div class="note" style="margin:-4px 0 8px">Chuyển tiếp lần @Math.Max(D.CarryTimes(t), 1) · từ @Fmt.Dm(fd)</div>
                }
                <div class="detail" id="det@(t.Id)" style="margin:6px 0 8px">
                    <div><span class="muted">Dự án:</span> @D.PjName(t.ProjectId)</div>
                    @if (t.PlanItemId is int iid)
                    {
                        <div><span class="muted">Đầu mục:</span> @(D.Item(iid)?.Title ?? "")</div>
                    }
                    <div><span class="muted">@(st == TaskState.Done ? "Kết quả / ghi chú" : "Lý do chưa hoàn thành"):</span> @(string.IsNullOrEmpty(t.Note) ? "—" : t.Note)</div>
                    @if (t.UpdatedAt is DateTime ua)
                    {
                        <div class="note">Cập nhật lúc @VnTime.Stamp(ua)</div>
                    }
                </div>
                <div class="btn-row">@if (!ro && sup)
                    {
                        @* Người hỗ trợ: chỉ tích "Đã hỗ trợ" — Leader dự án báo cáo kết quả *@
                        <form method="post" action="@Ui.To(req, "/Staff/TickSupport", ("d", dkey))" asp-antiforgery="true" class="inline">
                            @Ui.ReturnField(req)
                            <input type="hidden" name="taskId" value="@t.Id">
                            <input type="hidden" name="on" value="@(t.Supported ? "false" : "true")">
                            @Ui.TimeSelect("start", t.Start, id: "tS" + t.Id, extraAttrs: "style=\"width:auto;padding:5px 22px 5px 8px\" aria-label=\"Bắt đầu\"")
                            @Ui.TimeSelect("end", t.End, end: true, id: "tE" + t.Id, extraAttrs: "style=\"width:auto;padding:5px 22px 5px 8px\" aria-label=\"Kết thúc\"")
                            <button class="btn btn-sm @(t.Supported ? "" : "btn-primary")">@(t.Supported ? "Bỏ tích hỗ trợ" : "✓ Đã hỗ trợ")</button>
                        </form>
                    }
                    else if (!ro)
                    {
                        <partial name="_UpdateBtn" model="t" />
                    }</div>
            </div></li>
        }
    </ul>
}
else if (plan is not null)
{
    <div class="empty">Không có việc nào được chọn hôm nay.</div>
}
@if (teamTasks.Count > 0)
{
    @* Leader dự án chịu trách nhiệm báo cáo cuối ngày cho mọi việc của dự án mình phụ trách, kể cả việc người hỗ trợ làm một mình. *@
    <div class="h2">Việc của người hỗ trợ trong dự án bạn phụ trách</div>
    <ul class="tl">
        @foreach (var t in teamTasks)
        {
            var st = t.Status;
            var n = st != TaskState.Done ? D.Task(t.CarriedToId) : null;
            <li id="t@(t.Id)"><span class="dot" style="--nc:@Labels.Color(st)">@(st == TaskState.Done ? "✓" : "")</span><div class="card task">
                <div class="h"><div><div class="t">@t.Title</div><div class="src">@D.PName(t.EmployeeId) · @D.PjName(t.ProjectId)</div></div>@Ui.Pill(st)</div>
                <div class="tm">@t.Start – @t.End · <span class="@(t.Supported ? "" : "muted")">@(t.Supported ? "Đã tích hỗ trợ" : "Chưa tích hỗ trợ")</span></div>
                <partial name="_DoneReview" model="t" />
                @if (n is not null)
                {
                    <div class="nx-line">Kế hoạch tiếp: <b>@Fmt.Short(n.Date)</b> <span class="mono">@(n.Start)–@(n.End)</span> · @n.Title</div>
                }
                @if (!string.IsNullOrEmpty(t.Note))
                {
                    <div class="note">@(st == TaskState.Done ? "Kết quả / ghi chú" : "Lý do chưa hoàn thành"): @t.Note</div>
                }
                @if (!ro)
                {
                    <div class="btn-row"><partial name="_UpdateBtn" model="t" /></div>
                }
            </div></li>
        }
    </ul>
}
@if (!ro)
{
    <button type="button" class="btn btn-ghost btn-block" data-sheet="tplExtra" style="margin:4px 0 14px">＋ Đề xuất công việc phát sinh</button>
}
<section class="card sec">
    <h2>Danh sách phát sinh trong ngày</h2>
    @if (xs.Count > 0)
    {
        foreach (var x in xs)
        {
            @D.ExtraRow(x)
        }
    }
    else
    {
        <p class="note">Chưa có phát sinh.</p>
    }
</section>
@if (list.Count > 0 && openCnt > 0)
{
    <div class="notice" style="--nbg:var(--warn-soft);--nfg:var(--warn)"><span class="ic">!</span><div><b>Còn @openCnt việc chưa hoàn thành chưa có kế hoạch tiếp theo</b></div></div>
}
@if (teamOpen > 0)
{
    <div class="notice" style="--nbg:var(--warn-soft);--nfg:var(--warn)"><span class="ic">!</span><div><b>Còn @teamOpen việc của dự án bạn phụ trách chưa báo hoàn thành hay kế hoạch tiếp theo</b></div></div>
}
@if (supCnt > 0)
{
    <div class="notice" style="--nbg:var(--warn-soft);--nfg:var(--warn)"><span class="ic">!</span><div><b>Còn @supCnt việc hỗ trợ chưa tích “Đã hỗ trợ”</b></div></div>
}
<form id="eodForm" class="card sec" method="post" action="@Ui.To(req, "/Staff/SubmitReport", ("d", dkey))" asp-antiforgery="true" data-miss="@openCnt" data-miss-team="@teamOpen" data-miss-sup="@supCnt">
    @Ui.ReturnField(req)
    <h2>Tình hình chung</h2>
    <label class="f" for="eB" style="margin-top:0">Có vướng mắc không?</label>
    <select class="in" id="eB" name="blocked" disabled="@ro">
        <option value="no" selected="@(rep?.Blocked != true)">Không</option>
        <option value="yes" selected="@(rep?.Blocked == true)">Có</option>
    </select>
    <label class="f" for="eN">Ghi chú thêm (nếu có)</label><textarea class="in" id="eN" name="note" maxlength="2000" disabled="@ro">@(rep?.Note)</textarea>
    @if (!ro)
    {
        <button class="btn btn-primary btn-block" style="margin-top:12px">@(rep is not null ? "Gửi lại báo cáo cuối ngày" : "Gửi báo cáo cuối ngày")</button>
    }
</form>

@if (!ro)
{
    @* openExtra(false) *@
    <partial name="_ExtraSheet" model="@(new ExtraSheetVm { TemplateId = "tplExtra", Action = Ui.To(req, "/Staff/ProposeExtra", ("d", dkey)), ByLeader = false, EmployeeId = me.Id })" />

    @* openUpdate(t): một sheet cho mỗi việc *@
    foreach (var t in list.Where(x => !D.IsSupportTask(x)).Concat(teamTasks))
    {
        var cur = D.Task(t.CarriedToId);
        var it = D.Item(t.PlanItemId);
        var nds = StaffReports.NextDateOptions(t.Date, cur?.Date);
        var ndDef = cur?.Date ?? nds.First(x => x.DayOfWeek != DayOfWeek.Sunday);
        var done = t.Status == TaskState.Done;
        <template id="upd@(t.Id)">
            <form method="post" action="@Ui.To(req, "/Staff/UpdateTask", ("d", dkey))" data-upd data-state="@t.Status" data-end="@t.End">
                @Html.AntiForgeryToken()
                @Ui.ReturnField(req)
                <input type="hidden" name="taskId" value="@t.Id">
                <h3>Cập nhật công việc</h3>
                <p class="note" style="margin:0 0 4px">@t.Title</p>
                <div class="pick2 eq"><div><label class="f" for="wS" style="margin-top:0">Bắt đầu</label>@Ui.TimeSelect("start", t.Start, id: "wS")</div><div><label class="f" for="wE" style="margin-top:0">Kết thúc</label>@Ui.TimeSelect("end", t.End, end: true, id: "wE")</div></div>
                <div class="choices" role="radiogroup" aria-label="Trạng thái">
                    @foreach (var s in new[] { TaskState.InProgress, TaskState.Done, TaskState.Late, TaskState.NotStarted })
                    {
                        <label class="choice" style="--cc:@Labels.Color(s)"><input type="radio" name="state" value="@s" checked="@(t.Status == s)">@Labels.Of(s)</label>
                    }
                </div>
                @if (it is not null && it.Status != TaskState.Done)
                {
                    <label class="row" style="margin-top:10px;font-size:13px"><input type="checkbox" id="itDone" name="itemDone" value="true"> Đầu mục “@it.Title” đã xong toàn bộ</label>
                }
                <div id="nxWrap" class="nx" hidden="@done">
                    <div class="nx-h">Kế hoạch tiếp theo</div>
                    <label class="f" for="nxD">Chuyển sang ngày</label>@Ui.Select("nextDate", nds.Select(x => (Fmt.Key(x), StaffReports.NextDateLabel(x))), Fmt.Key(ndDef), id: "nxD")
                    <div class="pick2 eq">
                        <div><label class="f" for="nxS">Bắt đầu</label>@Ui.TimeSelect("nextStart", cur?.Start ?? t.Start, id: "nxS")</div>
                        <div><label class="f" for="nxE">Kết thúc</label>@Ui.TimeSelect("nextEnd", cur?.End ?? t.End, end: true, id: "nxE")</div>
                    </div>
                    <label class="f" for="nxT">Nội dung tiếp theo</label><input class="in" id="nxT" name="nextTitle" maxlength="300" value="@(cur?.Title ?? t.Title)">
                </div>
                <label class="f" for="uN" id="uNL">@(done ? "Kết quả / ghi chú" : "Lý do chưa hoàn thành (bắt buộc)")</label><textarea class="in" id="uN" name="note" maxlength="2000">@t.Note</textarea>
                <div class="btn-row" style="margin-top:14px"><button type="button" class="btn" data-x="close">Hủy</button><button class="btn btn-primary">Lưu cập nhật</button></div>
            </form>
        </template>
    }
}
