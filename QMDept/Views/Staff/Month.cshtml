@model StaffMonthVm
@* nvMonth(): Kế hoạch tháng. Chế độ "Tất cả nhân sự" (Leader/TP, ?as=all): teamDayList + calAssignForm (Giao thêm việc). *@
@{
    var req = Context.Request;
    var ms = Model.MonthStart;
    var mKey = Fmt.Key(ms);
    var today = Scope.Today;
    var sel = Scope.Date;
    var inM = Model.InMonth(sel);
    var ppl = Model.People;
    var me = Model.Me;
    // pickDay: chọn ngày (S.date = d, S.month = tháng của d, S.week = null)
    string DayHref(DateOnly d) => Ui.Here(req, ("d", Fmt.Key(d)), ("m", Fmt.Key(Fmt.MonthStart(d))), ("w", null));
    string DayCls(DateOnly d) => (d == today ? "today " : "") + (d == sel ? "sel" : "");
}
@if (Scope.Account.Role == Role.Leader || (Scope.IsManager && (Model.AllMode || Scope.IsViewingOther || Scope.OwnCalendar)))
{
    @* Kế hoạch tháng là mục của Tổng quan: TP / Quản trị và Leader (yêu cầu 2026-10-20; Leader chuyển từ Kế hoạch & duyệt); ô "Xem màn hình" nằm trong _OverviewTabs *@
    <partial name="_OverviewTabs" model="@("month")" />
}
else if (Model.AllMode)
{
    @Ui.Head(0, (Scope.IsManager ? "Lịch của phòng" : "Lịch nhóm") + " · Tất cả nhân sự", $"{ppl.Count} nhân sự")
}
else
{
    <div class="head">@if (!Model.ReadOnly) {<span class="step-n">1</span>}<div style="flex:1;min-width:0"><h1>Kế hoạch tháng</h1></div></div>
}
@if ((Scope.Account.Role == Role.Staff && Scope.TeamPeople.Count > 1) || (Scope.Account.Role is Role.Leader or Role.Manager or Role.Admin && (Scope.AllStaff || Scope.OwnCalendar || Scope.IsViewingOther)))
{
    @* NV / Leader xem lịch của mình hoặc lịch cả nhóm — yêu cầu 2026-10-15 (NV), 2026-10-16 (Leader: ?as=mine, chỉ xem) *@
    @Ui.Seg(new[] { (Ui.Here(req, ("as", Scope.Account.Role == Role.Staff ? "me" : "mine")), "Lịch của tôi", !Model.AllMode && !Scope.IsViewingOther, 0), (Ui.Here(req, ("as", "all")), Scope.IsManager ? "Lịch phòng" : "Lịch nhóm", Model.AllMode, 0) })
}
<partial name="_MonthBar" />

@if (Model.AllMode)
{
    <partial name="_LeaderProposals" />
    <div class="mgrid">
        @foreach (var x in Fmt.MonthHeader) { <div class="dow">@x</div> }
        @for (var k = 0; k < Model.Lead; k++) { <div></div> }
        @for (var k = 1; k <= Model.Days; k++)
        {
            var d = ms.AddDays(k - 1);
            var byEmp = D.TasksOn(d).Where(D.OkCal).ToLookup(t => t.EmployeeId);
            var per = ppl.Select(p => byEmp[p.Id].ToList()).ToList();
            var busy = per.Count(t => t.Count > 0);
            var tot = per.Sum(t => t.Count);
            var late = per.Any(t => t.Any(x => x.Status == TaskState.Late));
            var leaveCount = ppl.Count(p => D.OnLeave(d, p.Id) is not null);
            var (bg, fg) = StaffCalendar.TeamCellColor(busy, late, d == today);
            <a href="@DayHref(d)" class="@DayCls(d)" aria-pressed="@(d == sel ? "true" : "false")" aria-label="@($"{Fmt.DayLabel(d)}: {busy}/{ppl.Count} người có việc, {tot} việc")"><small>@k</small><span class="n" style="--dbg:@bg;--dfg:@fg">@busy</span><small class="mono mg-sub">@(tot > 0 ? tot + " việc" : "–")@(leaveCount > 0 ? " · N" + leaveCount : "")</small></a>
        }
    </div>
    @if (inM)
    {
        @* teamDayList(d) *@
        <section class="card wday"><h3>Công việc cả nhóm · @Fmt.WD[Fmt.Wday(sel)] @Fmt.Dm(sel)</h3>
            @foreach (var p in ppl)
            {
                var t = D.TasksOn(sel, p.Id).Where(D.OkCal).ToList();
                var leave = D.OnLeave(sel, p.Id) ?? D.PartLeave(sel, p.Id);   // nghỉ một phần ngày vẫn có việc
                var ot = D.OtOf(sel, p.Id) is { Status: not OtStatus.Rejected } o ? o : null;
                <div class="tmd"><div class="tmd-h">@if (Scope.Subordinates.Any(s => s.Id == p.Id)) {<a class="link" href="@Ui.Here(req, ("as", p.Id.ToString()), ("d", Fmt.Key(sel)), ("m", mKey), ("w", null))" style="color:var(--fg)">@p.Name</a>} else {<b>@p.Name</b>} @Ui.LevelPill(p) <span class="note">@if (leave is not null) {<b class="red" title="@Blocks.LeaveBrief(leave)">@(leave.LeaveType is null ? "Nghỉ" : Blocks.LeaveBrief(leave))</b>@(" · ")}@t.Count việc@(ot is not null ? $" · ĐK làm thêm {ot.Start}–{ot.End}" : "")</span></div>
                    @foreach (var x in t)
                    {
                        @D.TaskRow(x, leadOnly: true)
                        <partial name="_TaskActions" model="x" />
                    }
                </div>
            }
        </section>
        <partial name="_StaffProposals" model="Model" />
        @if (Scope.CanLead)
        {
            @* calAssignForm(d, ''): Giao thêm việc ngay trên lịch (form .ro-ok: dùng được ở chế độ xem) *@
            var pj0 = StaffCalendar.DefaultProject(D, sel);
            // Leader dự án của từng dự án: chọn dự án → nhãn vai trò tự đổi (khóa), ô tích để trắng (data-leads + site.js).
            var leadMap = D.ActivePj().Select(x => (x.Id, Lead: D.ProjectLead(x.Id)?.Id)).Where(x => x.Lead is not null).ToDictionary(x => x.Id.ToString(), x => x.Lead!.Value);
            var leadDefault = pj0 is int pl ? D.ProjectLead(pl)?.Id : null;
            // Form ẩn: chỉ mở bảng trượt khi bấm nút (yêu cầu 2026-10-16), giống "Đề xuất công việc" của NV.
            <div class="row" style="gap:8px;margin:10px 0;flex-wrap:wrap"><button type="button" class="btn btn-sm ro-ok" data-sheet="calAssignTpl">＋ Giao thêm việc</button></div>
            <template id="calAssignTpl">
            <form id="calAssignForm" class="ro-ok" method="post" action="@($"/Staff/AssignTask?d={Fmt.Key(sel)}&as=all")" data-leads="@System.Text.Json.JsonSerializer.Serialize(leadMap)">
                @Html.AntiForgeryToken()
                @Ui.ReturnField(req)
                <h3>Giao thêm việc</h3>
                <p class="note" style="margin:0 0 8px">@Fmt.WD[Fmt.Wday(sel)] @Fmt.Dm(sel)</p>
                <label class="f" for="calP" style="margin-top:0">Dự án</label>
                @Ui.Select("projectId", D.ActivePj().Select(p => (p.Id.ToString(), p.Name)), pj0?.ToString(), id: "calP", extraAttrs: "data-lead-for=\"calAssignForm\"")
                @Ui.ProjectLeadHint(D, D.ActivePj(), "calP", pj0)
                <label class="f" for="calT">Nội dung công việc phát sinh</label><input class="in" id="calT" name="title" maxlength="300">
                <div class="pick2 eq"><div><label class="f" for="calS">Bắt đầu</label>@Ui.TimeSelect("start", "08:00", id: "calS")</div><div><label class="f" for="calE">Kết thúc</label>@Ui.TimeSelect("end", "12:00", end: true, id: "calE")</div></div>
                <label class="f">Người tham gia</label>
                <div class="optbox">
                    @foreach (var p in (Scope.IsManager ? ppl.Where(x => x.Role == Role.Leader).ToList() : ppl))   @* Trưởng phòng chỉ giao cho Leader (không giao vượt cấp) *@
                    {
                        var n = D.TasksOn(sel, p.Id).Count(D.OkCal);
                        var leave = D.OnLeave(sel, p.Id);
                        <div class="trow"><input type="checkbox" id="calW_@p.Id" name="emp" value="@p.Id"><label for="calW_@p.Id" style="cursor:pointer;min-width:0"><div class="t">@p.Name @Ui.LevelPill(p, false)</div><div class="s">@if (leave is not null) {<b class="red">Nghỉ</b>@(" · ")}@n việc trong ngày</div></label>
                            <span class="pill @(p.Role == Role.Leader || leadDefault == p.Id ? "p-mgr" : "p-info")" data-role-tag="@p.Id"@(p.Role == Role.Leader ? " data-group-leader" : "")>@(p.Role == Role.Leader ? "Leader" : leadDefault == p.Id ? "Leader dự án" : "Hỗ trợ")</span></div>
                    }
                </div>
                <div class="btn-row" style="margin-top:14px"><button type="button" class="btn" data-x="close">Hủy</button>
                    <button class="btn btn-primary">Giao việc cho người đã chọn</button></div>
            </form>
            </template>
        }
    }
}
else if (me is null)
{
    <div class="empty">Nhóm chưa có nhân viên.</div>
}
else
{
    <div class="mgrid">
        @foreach (var x in Fmt.MonthHeader) { <div class="dow">@x</div> }
        @for (var k = 0; k < Model.Lead; k++) { <div></div> }
        @for (var k = 1; k <= Model.Days; k++)
        {
            var d = ms.AddDays(k - 1);
            var t = D.TasksOn(d, me.Id).Where(D.OkCal).ToList();
            var (bg, fg) = StaffCalendar.CellColor(t, d == today);
            <a href="@DayHref(d)" class="@DayCls(d)" aria-pressed="@(d == sel ? "true" : "false")" aria-label="@($"{Fmt.DayLabel(d)}: {t.Count} việc")"><small>@k</small><span class="n" style="--dbg:@bg;--dfg:@fg">@t.Count</span></a>
        }
    </div>
    @if (inM)
    {
        var t = D.TasksOn(sel, me.Id).Where(D.OkCal).ToList();
        var ownLead = Scope.OwnCalendar && me.Role != Role.Staff;   // Leader ở "Lịch của tôi": cập nhật kế hoạch cá nhân (yêu cầu 2026-10-17)
        <section class="card wday"><h3>@Fmt.WD[Fmt.Wday(sel)] – @Fmt.Dm(sel) (@t.Count công việc)@(D.OnLeave(sel, me.Id) is not null ? " · Nghỉ" : D.PartLeave(sel, me.Id) is not null ? " · Nghỉ một phần" : "")</h3>
            @if ((D.OnLeave(sel, me.Id) ?? D.PartLeave(sel, me.Id)) is { } mlv) { <p class="note red" style="padding:6px 12px 0;margin:0"><b>@Blocks.LeaveBrief(mlv)</b></p> }
            @if (t.Count > 0)
            {
                foreach (var x in t)
                {
                    @D.TaskRow(x)
                    @if (ownLead) { <partial name="_TaskActions" model="x" /> }
                }
            }
            else { <p class="note" style="padding:8px 12px;margin:0">Ngày này chưa có công việc.</p> }
        </section>
        @if (ownLead)
        {
            @* Cập nhật kế hoạch cá nhân / xin nghỉ gộp MỘT sheet (yêu cầu 2026-10-20): Leader có ô "Loại" (xin nghỉ → Trưởng phòng duyệt; nghỉ nửa ngày / vài giờ thì hiện thêm phần công việc); TP / Quản trị chỉ cập nhật kế hoạch *@
            var isLd = Scope.Account.Role == Role.Leader;
            <div class="row" style="gap:8px;margin:10px 0;flex-wrap:wrap"><button type="button" class="btn btn-sm" data-sheet="ownTaskTpl">@(isLd ? "＋ Cập nhật kế hoạch cá nhân / xin nghỉ" : "＋ Cập nhật kế hoạch cá nhân")</button></div>
            @if (isLd && Model.LeaveRequests.Count > 0) { <section class="card sec"><h2>Đề xuất của tôi · @Fmt.Dm(sel)</h2><partial name="_LeaveRequestRows" model="Model.LeaveRequests" /></section> }
            <template id="ownTaskTpl">
                <form method="post" action="@Ui.To(req, "/Staff/AddOwnTask", ("d", Fmt.Key(sel)))">
                    @Html.AntiForgeryToken()
                    @Ui.ReturnField(req)
                    <h3>@(isLd ? "Cập nhật kế hoạch cá nhân / xin nghỉ" : "Cập nhật kế hoạch cá nhân")</h3>
                    <p class="note" style="margin:0 0 8px">@Fmt.WD[Fmt.Wday(sel)] @Fmt.Dm(sel)</p>
                    @if (isLd)
                    {
                        <label class="f" for="ownK" style="margin-top:0">Loại</label>
                        <select class="in" id="ownK" name="kind" data-kind data-nosearch>
                            <option value="work">Cập nhật kế hoạch cá nhân</option>
                            <option value="leave">Xin nghỉ</option>
                        </select>
                        <partial name="_LeaveFields" model="@("own")" />
                    }
                    <div data-work-block>
                    <h4 class="f" data-work-title hidden style="margin:14px 0 0">Công việc làm trong thời gian còn lại</h4>
                    <label class="f" for="ownP" style="margin-top:0">Dự án</label>
                    @Ui.Select("projectId", D.ActivePj().Select(p => (p.Id.ToString(), p.Name)), StaffCalendar.DefaultProject(D, sel)?.ToString(), id: "ownP")
                    @Ui.ProjectLeadHint(D, D.ActivePj(), "ownP", StaffCalendar.DefaultProject(D, sel))
                    <label class="f" for="ownT">Nội dung công việc</label><input class="in" id="ownT" name="title" maxlength="300">
                    <div class="pick2 eq"><div><label class="f" for="ownS">Bắt đầu</label>@Ui.TimeSelect("start", "08:00", id: "ownS")</div><div><label class="f" for="ownE">Kết thúc</label>@Ui.TimeSelect("end", "12:00", end: true, id: "ownE")</div></div>
                    </div>
                    <div class="btn-row" style="margin-top:14px"><button type="button" class="btn" data-x="close">Hủy</button>
                        <button class="btn btn-primary" data-lbl-leave="Gửi đề xuất">Lưu vào kế hoạch</button></div>
                </form>
            </template>
        }
        <partial name="_StaffProposals" model="Model" />
    }
}
