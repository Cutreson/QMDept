@model PlanningInboxVm
@* Leader → Kế hoạch & duyệt → "Kế hoạch đề xuất" (yêu cầu 2026-10-19): gộp kế hoạch đầu ngày của NV + phát sinh + đề xuất lịch (thêm việc / người hỗ trợ ở lịch tháng)
   + đăng ký làm thêm (kèm kết quả làm thêm), chia 2 mục riêng "Chờ duyệt" / "Đã duyệt" (?f=pending|approved). Thẻ: _PlanCard, _OtCard. *@
@{
    var req = Context.Request;
    var pend = Model.Filter == "pending";
    var canWrite = Scope.CanLead && !Scope.IsReadOnly;
    var empty = Model.Plans.Count == 0 && Model.Extras.Count == 0 && Model.Proposals.Count == 0 && Model.Ots.Count == 0;
}
<partial name="_PlanningTabs" model="@("proposals")" />
<partial name="_DayBar" />
@Ui.Seg(new[]
{
    (Ui.Here(req, ("f", "pending")), $"Chờ duyệt ({Model.PendingTotal})", pend, 0),
    (Ui.Here(req, ("f", "approved")), $"Đã duyệt ({Model.ApprovedTotal})", !pend, 0),
})
@if (pend && Model.NotSent.Count > 0)
{
    <p class="note">Chưa gửi kế hoạch: @string.Join(", ", Model.NotSent.Select(p => p.Name))</p>
}
@if (empty)
{
    <div class="empty">@(pend ? "Không còn mục nào chờ duyệt." : "Chưa có mục nào đã duyệt.")</div>
}

@if (Model.Plans.Count > 0)
{
    <h2 class="h2">Kế hoạch đầu ngày (@Model.Plans.Count)</h2>
    foreach (var p in Model.Plans)
    {
        <partial name="_PlanCard" model="p" />
    }
}

@if (Model.Extras.Count > 0)
{
    <section class="card sec">
        <h2>Phát sinh chờ duyệt</h2>
        @foreach (var x in Model.Extras)
        {
            @D.ExtraRow(x)
            if (canWrite)
            {
                <div class="btn-row" style="margin:0 0 8px 32px">
                    <form method="post" action="/Planning/ApproveExtra" asp-antiforgery="true">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@x.Id">
                        <button class="btn btn-sm btn-ok">Duyệt</button>
                    </form>
                    <form method="post" action="/Planning/RejectExtra" asp-antiforgery="true"
                          data-prompt="Từ chối phát sinh" data-prompt-label="Lý do" data-prompt-required data-prompt-name="reason">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@x.Id">
                        <button class="btn btn-sm btn-no">Từ chối</button>
                    </form>
                </div>
            }
        }
    </section>
}

@if (Model.Proposals.Count > 0)
{
    <section class="card sec"><h2>Đề xuất lịch (@Model.Proposals.Count)</h2>
        @if (pend)
        {
            foreach (var x in Model.Proposals)
            {
                var who = x.People.Select(p => D.PName(p.EmployeeId)).ToList();   // người thực hiện (gồm cả người đề xuất nếu "Tôi thực hiện")
                <div class="asg">
                    <div class="row"><b>@D.PName(x.ProposerId)</b><span class="note" style="margin-left:auto">@Fmt.Short(x.Date) · <span class="mono">@x.Start–@x.End</span></span></div>
                    <div class="t" style="margin-top:4px">@x.Title</div>
                    <div class="note">@D.PjName(x.ProjectId)@(who.Count > 0 ? " · Thực hiện: " + string.Join(", ", who) : "")@(string.IsNullOrEmpty(x.Departments) ? "" : " · Xin hỗ trợ: " + Fmt.QuotaText(x.Departments))</div>
                    @if (!string.IsNullOrEmpty(x.SupportReason)) { <div class="note">Lý do xin hỗ trợ: @x.SupportReason</div> }
                    @if (canWrite)
                    {
                        <div class="btn-row">
                            <form method="post" action="/Planning/DecideProposal" asp-antiforgery="true">
                                @Ui.ReturnField(req)
                                <input type="hidden" name="id" value="@x.Id"><input type="hidden" name="v" value="ok">
                                <button class="btn btn-ok">✓ Duyệt</button>
                            </form>
                            <form method="post" action="/Planning/DecideProposal" asp-antiforgery="true"
                                  data-prompt="Từ chối đề xuất của @D.PName(x.ProposerId)" data-prompt-label="Lý do từ chối" data-prompt-required data-prompt-name="note">
                                @Ui.ReturnField(req)
                                <input type="hidden" name="id" value="@x.Id"><input type="hidden" name="v" value="no">
                                <button class="btn btn-no">✕ Từ chối</button>
                            </form>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            foreach (var x in Model.Proposals)
            {
                var ok = x.Status == ExtraStatus.Approved;
                <div class="trow"><span class="ck @(ok ? "on" : "")">@(ok ? "✓" : "")</span>
                    <div><div class="t">@x.Title</div>
                        <div class="s">@D.PName(x.ProposerId) · @D.PjName(x.ProjectId) · @Fmt.Short(x.Date)@(!ok && !string.IsNullOrEmpty(x.Reason) ? " · Lý do: " + x.Reason : "")</div></div>
                    <span class="pill @(ok ? "p-ok" : "p-bad")">@(ok ? "Đã duyệt" : "Từ chối")</span></div>
            }
        }
    </section>
}

@if (Model.Ots.Count > 0)
{
    <h2 class="h2">Đăng ký làm thêm (@Model.Ots.Count)</h2>
    foreach (var x in Model.Ots)
    {
        <partial name="_OtCard" model="x" />
    }
}
