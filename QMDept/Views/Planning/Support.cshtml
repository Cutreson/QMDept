@model PlanningSupportVm
@* Leader nhóm được xin hỗ trợ: xác nhận + chọn nhân viên (yêu cầu 2026-10-23). Controller: PlanningController.Support.cs. *@
@{
    ViewData["Title"] = "Hỗ trợ nhân sự";
    var req = Context.Request;
    var pending = Model.Filter == "pending";
    var team = D.Team(Scope.Account.Id).Where(p => p.Role == Role.Staff).OrderBy(p => p.Name, Fmt.ViCompare).ToList();
}
<partial name="_PlanningTabs" model="@("support")" />
<partial name="_DayBar" />
@Ui.Seg(new[]
{
    (Ui.Here(req, ("f", "pending")), "Chờ xác nhận (" + Model.PendingTotal + ")", pending, 0),
    (Ui.Here(req, ("f", "done")), "Đã xác nhận (" + Model.DoneTotal + ")", !pending, 0),
})
@if (pending && Model.OtherPending.Count > 0)
{
    <p class="note" style="margin:0 0 8px">Còn chờ xác nhận ngày khác: @foreach (var (od, oc) in Model.OtherPending) { <a class="link" href="@Ui.Here(req, ("d", Fmt.Key(od)), ("f", "pending"))">@Fmt.Dmy(od) (@oc)</a><text> </text> }</p>
}
@if (Model.Requests.Count == 0)
{
    <div class="empty">@(pending ? "Không có yêu cầu hỗ trợ nào chờ xác nhận ngày này." : "Chưa có yêu cầu hỗ trợ nào được xác nhận ngày này.")</div>
}
@foreach (var x in Model.Requests)
{
    var tasks = D.Chosen(x.Date, x.RequesterId);
    <section class="card apv">
        <div class="hd">@Ui.Av(D.PName(x.RequesterId))<b>@D.PName(x.RequesterId)</b><span class="pill @(x.Confirmed ? "p-ok" : "p-warn")">@(x.Confirmed ? "Đã xác nhận" : "Chờ xác nhận")</span></div>
        <p class="note" style="margin:0 0 6px">Xin <b>@x.Qty</b> người hỗ trợ · @Fmt.DayLabel(x.Date)</p>
        @if (tasks.Count > 0)
        {
            <div class="note" style="margin:0 0 6px">@foreach (var t in tasks) { <div>@D.PjName(t.ProjectId) · @t.Title · <span class="mono">@t.Start–@t.End</span></div> }</div>
        }
        @if (!string.IsNullOrEmpty(x.Reason)) { <div class="cmt"><b>Lý do:</b> @x.Reason</div> }
        @if (x.Confirmed)
        {
            <p class="note" style="margin:8px 0 0">Nhân viên hỗ trợ: <b>@string.Join(", ", x.StaffList.Select(sid => D.PName(sid)))</b> · @x.ConfirmedBy @VnTime.Hm(x.ConfirmedAt)</p>
        }
        else
        {
            <form method="post" action="/Planning/ConfirmSupport" asp-antiforgery="true">
                @Ui.ReturnField(req)
                <input type="hidden" name="id" value="@x.Id">
                <div style="margin:8px 0">
                    @foreach (var p in team)
                    {
                        var leave = D.OnLeave(x.Date, p.Id) is not null;
                        <label class="trow" style="grid-template-columns:22px 1fr;cursor:pointer"><input type="checkbox" name="emp" value="@p.Id"><div><div class="t">@p.Name @Ui.LevelPill(p, false)</div><div class="s">@(leave ? "Nghỉ ngày này" : D.TasksOn(x.Date, p.Id).Count + " việc trong ngày")</div></div></label>
                    }
                </div>
                <button class="btn btn-ok btn-block">✓ Xác nhận (chọn tối đa @x.Qty người)</button>
            </form>
        }
    </section>
}
