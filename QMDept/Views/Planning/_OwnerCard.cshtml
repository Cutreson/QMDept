@model (Project P, string Prefix, List<Person> Leaders)
@* Thẻ một dự án ở trang "Leader phụ trách dự án": tên, Leader hiện tại, ô chọn Leader + Lưu (dự án đã hoàn thành vẫn gán được Leader, để biết ai từng phụ trách). Dùng cho danh sách theo mục và kết quả tìm kiếm. *@
@{
    var p = Model.P;
    var req = Context.Request;
    var owner = p.OwnerLeaderId is int oid ? D.P(oid) : null;
    var done = p.Closed || D.PjStatus(p.Id, Scope.Date) == ProjectStatus.Completed;
}
<form class="card sec" method="post" action="/Planning/SetProjectOwner" asp-antiforgery="true" data-pj-key="@PlanningManage.SearchKey(p, owner?.Name)">
    @Ui.ReturnField(req)
    <input type="hidden" name="projectId" value="@p.Id">
    <div class="row">@Ui.Ptile(D.Tile(p.Id), p.Name, 28)<div><b>@p.Name</b>@if (done) { <text> </text><span class="pill p-ok">Hoàn thành</span> }<div class="note">@Dept.SubLine(p)</div></div>
        <span class="note" style="margin-left:auto;text-align:right">@(owner is null ? "Chưa có Leader phụ trách" : "Leader phụ trách: " + owner.Name)</span></div>
        <label class="f" for="@(Model.Prefix)@(p.Id)">Leader phụ trách</label>
        <div class="row" style="gap:8px">
            <select class="in" id="@(Model.Prefix)@(p.Id)" name="leaderId" style="flex:1;min-width:0">
                <option value="" selected="@(owner is null)">— Chưa chọn —</option>
                @foreach (var l in Model.Leaders)
                {
                    <option value="@l.Id" selected="@(owner?.Id == l.Id)">@l.Name · nhóm @D.Team(l.Id).Count người</option>
                }
            </select>
            <button class="btn btn-primary">Lưu</button>
        </div>
</form>
