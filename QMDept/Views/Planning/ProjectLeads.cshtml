@model PlanningLeadsVm
@* Chọn Leader dự án cho từng dự án đang triển khai. Dự án đã có Leader dự án mới hiện ở "Thông tin dự án" của người đó.
   Ô "Dự án" (ô chọn có tìm kiếm như Giao thêm việc — quy tắc 45): chọn dự án → hiện đúng dự án đó + Leader dự án; "Tất cả dự án" → danh sách theo mục. *@
@{
    var req = Context.Request;
}
<partial name="_PlanningTabs" model="@("leads")" />
@if (Model.Staff.Count == 0)
{
    <div class="empty">Chưa có nhân viên để chọn.</div>
    return;
}
<div style="margin:6px 0 10px">
    <label class="f" for="pjSearch" style="margin-top:0">Dự án</label>
    @Ui.Select("pjSearch", new[] { ("", "— Tất cả dự án —") }.Concat(Model.AllProjects.Select(p => (p.Id.ToString(), string.IsNullOrEmpty(p.Code) ? p.Name : p.Code + " · " + p.Name))), "", id: "pjSearch")
</div>
<div id="pjResults" hidden>
    @foreach (var p in Model.AllProjects) { <partial name="_LeadCard" model="@((p, "pa", Model.Staff))" /> }
</div>
<div id="pjList">
@Ui.Seg(new[]
{
    (Ui.Here(req, ("f", "has")), $"Đã có Leader dự án ({Model.HasCount})", Model.Filter == "has", 0),
    (Ui.Here(req, ("f", "none")), $"Chưa chọn Leader dự án ({Model.NoneCount})", Model.Filter == "none", 0),
})
@if (Model.Projects.Count == 0)
{
    <div class="empty">@(Model.Filter == "has" ? "Chưa có dự án nào được chọn Leader dự án." : "Mọi dự án đã được chọn Leader dự án.")</div>
}
@foreach (var p in Model.Projects)
{
    <partial name="_LeadCard" model="@((p, "pl", Model.Staff))" />
}
</div>
@section Scripts {
    <script>
    (function () {
        var sel = document.getElementById('pjSearch'), res = document.getElementById('pjResults'), list = document.getElementById('pjList');
        if (!sel) return;
        var cards = [].slice.call(res.querySelectorAll('[data-pj-id]'));
        function run() {
            var v = sel.value;
            if (!v) { res.hidden = true; list.hidden = false; return; }
            cards.forEach(function (c) { c.hidden = c.getAttribute('data-pj-id') !== v; });
            res.hidden = false; list.hidden = true;
        }
        sel.addEventListener('change', run);
        run();
    })();
    </script>
}
