@model PlanningReportsVm
@* Leader → Kế hoạch & duyệt → Báo cáo: port ldEodApprove() + carrySection(d)
   (+ handler eodDecide / eodUndo / carryOk / carryAll / carryUndo / eodCarry). Controller nạp [ngày, ngày + 14]. *@
@{
    var req = Context.Request;
    var d = Scope.Date;
    var canWrite = Scope.CanLead && !Scope.IsReadOnly;
}
<partial name="_PlanningTabs" model="@("reports")" />
<partial name="_DayBar" />
@{
    // Báo cáo cuối ngày chia 2 mục: Chờ duyệt / Đã duyệt (yêu cầu 2026-10-20); đề xuất chuyển kế hoạch nằm ngay trong thẻ báo cáo của từng nhân viên
    var f = req.Query["f"] == "approved" ? "approved" : "pending";
    var pendReports = Model.Reports.Where(x => x.LeaderDecision is null).ToList();
    var doneReports = Model.Reports.Where(x => x.LeaderDecision is not null).ToList();
    var shownReports = f == "pending" ? pendReports : doneReports;
    var orphanCarries = f == "pending" ? Model.Carries.Where(n => !n.CarryOk && D.IsTeamStaff(n.EmployeeId) && !Model.Reports.Any(x => x.EmployeeId == n.EmployeeId)).ToList() : new List<WorkTask>();
    var orphanAll = Model.Carries.Count(n => !n.CarryOk && D.IsTeamStaff(n.EmployeeId) && !Model.Reports.Any(x => x.EmployeeId == n.EmployeeId));
}
@Ui.Seg(new[]
{
    (Ui.Here(req, ("f", "pending")), $"Chờ duyệt ({pendReports.Count + orphanAll})", f == "pending", 0),
    (Ui.Here(req, ("f", "approved")), $"Đã duyệt ({doneReports.Count})", f == "approved", 0),
})


@if (f == "pending" && Model.NotSent.Count > 0)
{
    <p class="note">Chưa gửi báo cáo cuối ngày: @string.Join(", ", Model.NotSent.Select(p => p.Name))</p>
}

@* Việc chuyển tiếp chờ duyệt mà nhân viên CHƯA có thẻ báo cáo (vd. Leader dự án báo thay kết quả → tạo việc chuyển tiếp): trước đây không hiện ở đâu dù số đỏ vẫn đếm (yêu cầu 2026-10-23) *@
@foreach (var n in orphanCarries)
{
    <section class="card apv">
        <div class="hd">@Ui.Av(D.PName(n.EmployeeId))<b>@D.PName(n.EmployeeId) <span class="note">việc chuyển tiếp từ @Fmt.Dmy(n.FromDate ?? d)</span></b><span class="pill p-warn">Chờ duyệt</span></div>
        <div class="nx-line row" style="margin:0;align-items:flex-start">
            <div style="flex:1">@D.PjName(n.ProjectId) · Chuyển sang: <b>@Fmt.WDS[Fmt.Wday(n.Date)] @Fmt.Dm(n.Date)</b> <span class="mono">@n.Start–@n.End</span> · @n.Title</div>
            @if (canWrite)
            {
                <form method="post" action="/Planning/ApproveCarry" class="inline" asp-antiforgery="true">@Ui.ReturnField(req)<input type="hidden" name="id" value="@n.Id"><button class="btn btn-sm btn-ok">Duyệt</button></form>
                @if (PlanningReportsVm.CanEditCarry(n)) { <button type="button" class="btn btn-sm" data-sheet="carrySheet@(n.Id)">Sửa</button> }
            }
        </div>
    </section>
}
@* ---------- ldEodApprove(): báo cáo cuối ngày ---------- *@
@if (shownReports.Count == 0 && orphanCarries.Count == 0)
{
    <div class="empty">@(f == "pending" ? "Không còn báo cáo cuối ngày nào chờ duyệt." : "Chưa có báo cáo cuối ngày nào đã duyệt.")</div>
}
@foreach (var r in shownReports)
{
    var st = Dept.EodSt(r);
    var name = D.PName(r.EmployeeId);
    var ts = D.Chosen(d, r.EmployeeId);
    var c = Dept.Count(ts);
    var xs = D.ExtrasOn(d).Count(x => x.EmployeeId == r.EmployeeId);
    <section class="card apv">
        <div class="hd">@Ui.Av(name)<b>@name <span class="note mono">gửi @VnTime.Hm(r.SentAt)</span></b>@Ui.Pill(st)</div>
        <div class="pmeta">
            <span>Hoàn thành <b class="mono">@c.Done/@ts.Count</b></span>
            @if (c.Late > 0)
            {
                <span class="pill p-bad">@c.Late chậm</span>
            }
            @if (r.Blocked)
            {
                <span class="pill p-bad">Có vướng mắc</span>
            }
            @if (xs > 0)
            {
                <span>@xs phát sinh</span>
            }
        </div>
        @if (ts.Count == 0)
        {
            <p class="note">Không có việc nào được chọn.</p>
        }
        @foreach (var t in ts)
        {
            var n = PlanningReportsVm.NextOf(D, t);
            @D.TaskRow(t)
            if (!string.IsNullOrEmpty(t.Note))
            {
                <div class="note" style="margin:-4px 0 6px 44px">@(t.Status == TaskState.Done ? "Kết quả" : "Lý do chưa hoàn thành"): @t.Note</div>
            }
            if (n is not null)
            {
                <div class="nx-line row" style="margin:0 0 8px 44px;align-items:flex-start">
                    <div style="flex:1">Đề xuất chuyển: <b>@Fmt.WDS[Fmt.Wday(n.Date)] @Fmt.Dm(n.Date)</b> <span class="mono">@n.Start–@n.End</span> · @n.Title
                        @if (!string.IsNullOrEmpty(n.EditedBy))
                        {
                            <div class="note">@n.EditedBy đã chỉnh</div>
                        }
                    </div>
                    @if (canWrite && !n.CarryOk)
                    {
                        @* Duyệt riêng đề xuất chuyển (vd. NV sửa chuyển tiếp sau khi báo cáo đã duyệt) — mục "Đề xuất chuyển kế hoạch" riêng đã bỏ *@
                        <form method="post" action="/Planning/ApproveCarry" class="inline" asp-antiforgery="true">@Ui.ReturnField(req)<input type="hidden" name="id" value="@n.Id"><button class="btn btn-sm btn-ok">Duyệt</button></form>
                    }
                    @if (canWrite && PlanningReportsVm.CanEditCarry(n))
                    {
                        <button type="button" class="btn btn-sm" data-sheet="carrySheet@(n.Id)">Sửa</button>
                    }
                </div>
            }
        }
        @if (!string.IsNullOrEmpty(r.Note))
        {
            <div class="cmt" style="margin-top:8px"><b>Ghi chú nhân viên:</b> @r.Note</div>
        }
        @if (!string.IsNullOrEmpty(r.LeaderNote))
        {
            <div class="cmt"><b>Góp ý Leader:</b> @r.LeaderNote</div>
        }
        @if (r.LeaderDecision is null)
        {
            if (canWrite)
            {
                <div class="btn-row" style="margin-top:8px">
                    <form method="post" action="/Planning/DecideReport" asp-antiforgery="true"
                          data-prompt="Yêu cầu @name bổ sung báo cáo" data-prompt-label="Nội dung cần bổ sung" data-prompt-required
                          data-prompt-name="note" data-prompt-value="@r.LeaderNote">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@r.Id"><input type="hidden" name="v" value="no">
                        <button class="btn btn-no">Yêu cầu bổ sung</button>
                    </form>
                    <form method="post" action="/Planning/DecideReport" asp-antiforgery="true">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@r.Id"><input type="hidden" name="v" value="ok">
                        <button class="btn btn-ok">✓ Duyệt</button>
                    </form>
                </div>
            }
        }
        else
        {
            <div class="note" style="margin:1em 0 0">@(string.IsNullOrEmpty(r.LeaderBy) ? "Leader" : r.LeaderBy) @(st == EodState.Approved ? "đã duyệt" : "yêu cầu bổ sung") lúc @VnTime.Hm(r.LeaderAt)
                @if (canWrite)
                {
                    <form method="post" action="/Planning/UndoReportDecision" class="inline" asp-antiforgery="true">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@r.Id">
                        <button class="link">Hoàn tác</button>
                    </form>
                }
            </div>
        }
    </section>
}

@* ---------- eodCarry: sheet "Chỉnh kế hoạch tiếp theo" cho từng việc chuyển tiếp ---------- *@
@if (canWrite)
{
    foreach (var n in Model.SheetTasks)
    {
        var days = PlanningApproval.CarryDays(n);
        <template id="carrySheet@(n.Id)">
            <form method="post" action="/Planning/EditCarry">
                @Html.AntiForgeryToken()
                @Ui.ReturnField(req)
                <input type="hidden" name="id" value="@n.Id">
                <h3>Chỉnh kế hoạch tiếp theo</h3>
                <p class="note" style="margin:0 0 8px">@D.PName(n.EmployeeId) · chuyển tiếp từ @Fmt.Dm(n.FromDate)</p>
                <label class="f" for="cD" style="margin-top:0">Chuyển sang ngày</label>
                @Ui.Select("date", days.Select(x => (Fmt.Key(x), PlanningApproval.CarryDayLabel(x))), Fmt.Key(n.Date), id: "cD")
                <div class="pick2 eq">
                    <div><label class="f" for="cS">Bắt đầu</label>@Ui.TimeSelect("start", n.Start, id: "cS")</div>
                    <div><label class="f" for="cE">Kết thúc</label>@Ui.TimeSelect("end", n.End, end: true, id: "cE")</div>
                </div>
                <label class="f" for="cT">Nội dung</label>
                <input class="in" id="cT" name="title" value="@n.Title" required maxlength="@PlanningApproval.TitleMax">
                <div class="btn-row" style="margin-top:14px"><button type="button" class="btn" data-x="close">Hủy</button>
                    <button class="btn btn-primary">Lưu</button></div>
            </form>
        </template>
    }
}
