@model PlanningAssignVm
@* ldAssign(): giao việc cho 1 NV (assignForm), KPI phân công, việc đã giao gần đây, phân công theo nhân viên / theo dự án. *@
@{
    var req = Context.Request;
    var list = Model.Staff;
}
<partial name="_PlanningTabs" model="@("assign")" />
<partial name="_DayBar" />
@if (list.Count == 0)
{
    <div class="empty">Nhóm chưa có nhân viên. Trưởng phòng xếp nhóm ở tab Nhân sự.</div>
    return;
}
@{
    var teamProjects = D.TeamProjects();
    var mine = D.Assigns.Where(a => D.InScope(a.EmployeeId) && D.P(a.EmployeeId) is { Role: Role.Staff, IsDeleted: false } && D.PJ(a.ProjectId) is { Closed: false }).ToList();
    var pjs = D.ActivePj();
    var pj0 = pjs.FirstOrDefault()?.Id;
}
@* assignForm *@
<form id="assignForm" class="card sec" method="post" action="/Planning/AssignTask" asp-antiforgery="true">
    <h2>Giao việc cho nhân viên</h2>
    @Ui.ReturnField(req)
    <div class="grid2"><div><label class="f" for="asgW" style="margin-top:0">Nhân viên</label>
            @Ui.Select("emp", list.Select(p => (p.Id.ToString(), p.Name + (p.Level is Level level ? " · " + Labels.Of(level) : ""))), null, id: "asgW")</div>
        <div><label class="f" for="asgD" style="margin-top:0">Ngày làm</label><input class="in" type="date" id="asgD" name="date" value="@Fmt.Key(Scope.Date)"></div>
        <div><label class="f" for="asgP">Dự án</label>
            @Ui.Select("projectId", pjs.Select(p => (p.Id.ToString(), p.Name)), pj0?.ToString(), id: "asgP", extraAttrs: "data-items-for=\"asgI\"")</div>
        <div><label class="f" for="asgI">Đầu mục kế hoạch</label><select class="in" id="asgI" name="itemId"><option value="">— Việc khác (tự nhập) —</option>
            @if (pj0 is int p0)
            {
                foreach (var i in D.ItemsOf(p0))
                {
                    <option value="@i.Id">@i.Title</option>
                }
            }
        </select></div></div>
    <label class="f" for="asgT">Nội dung công việc</label><input class="in" id="asgT" name="title" maxlength="300">
    <div class="pick2 eq"><div><label class="f" for="asgS">Bắt đầu</label>@Ui.TimeSelect("start", "08:00", id: "asgS")</div><div><label class="f" for="asgE">Kết thúc</label>@Ui.TimeSelect("end", "12:00", end: true, id: "asgE")</div></div>
    <label class="f">Vai trò trong dự án</label>
    <div class="segr two" role="radiogroup" aria-label="Vai trò trong dự án"><label><input type="radio" name="role" value="@ProjectRole.Lead"><span>Leader dự án</span></label><label><input type="radio" name="role" value="@ProjectRole.Support" checked><span>Hỗ trợ dự án</span></label></div>
    <button class="btn btn-primary btn-block" style="margin-top:12px">Giao việc</button>
    
</form>
<partial name="_ItemsJson" />
<div class="kpis k4"><div class="kpi k-info"><b>@teamProjects.Count</b><span>Dự án nhóm quản lý</span></div><div class="kpi k-mgr"><b>@(mine.Count(a => a.Role == ProjectRole.Lead))</b><span>Leader dự án</span></div><div class="kpi k-ok"><b>@(mine.Count(a => a.Role != ProjectRole.Lead))</b><span>Hỗ trợ dự án</span></div><div class="kpi k-idle"><b>@(list.Count(p => D.AssignsOf(p.Id).Count == 0))</b><span>Chưa được giao</span></div></div>
<section class="card sec"><h2>Việc đã giao gần đây (@Model.Given.Count)</h2>
    @if (Model.Given.Count > 0)
    {
        foreach (var t in Model.Given)
        {
            var done = t.Status == TaskState.Done;
            <div class="trow"><span class="ck @(done ? "on" : "")">@(done ? "✓" : "")</span><div><div class="t">@t.Title</div><div class="s">@D.PName(t.EmployeeId) · @D.PjName(t.ProjectId) · @Fmt.Short(t.Date) · @Labels.Of(t.Status)</div></div>
                <span class="tm">@t.Start–@t.End <form method="post" action="/Planning/DeleteTask" asp-antiforgery="true" class="inline" data-confirm="Xóa “@t.Title” khỏi lịch?" data-confirm-label="Xóa">@Ui.ReturnField(req)<input type="hidden" name="id" value="@t.Id"><button class="link" aria-label="Xóa việc" style="color:var(--bad);margin-left:6px">✕</button></form></span></div>
        }
    }
    else
    {
        <p class="note">Chưa giao việc nào trong 7 ngày qua.</p>
    }
</section>
<section class="card sec"><h2>Phân công theo nhân viên</h2>
    @foreach (var p in list)
    {
        var asg = D.AssignsOf(p.Id);
        <div class="asg"><div class="row"><b>@p.Name</b>@Ui.LevelPill(p)<span class="note" style="margin-left:auto">@asg.Count dự án</span></div>
            @if (asg.Count > 0)
            {
                foreach (var a in asg)
                {
                    <div class="trow">@Ui.Ptile(D.Tile(a.ProjectId), D.PjName(a.ProjectId), 22)<div><div class="t">@D.PjName(a.ProjectId)</div>@if (!string.IsNullOrEmpty(a.Note)) {<div class="s">@a.Note</div>}</div>
                        <span class="tm"><span class="pill @(a.Role == ProjectRole.Lead ? "p-mgr" : "p-info")">@Labels.Of(a.Role)</span> <form method="post" action="/Planning/Unassign" asp-antiforgery="true" class="inline" data-confirm="Bỏ giao @D.PjName(a.ProjectId) cho @p.Name?" data-confirm-label="Bỏ giao">@Ui.ReturnField(req)<input type="hidden" name="id" value="@a.Id"><button class="link" style="color:var(--bad);margin-left:6px" aria-label="Bỏ giao">✕</button></form></span></div>
                }
            }
            else
            {
                <p class="note" style="margin:4px 0 0">Chưa được giao dự án.</p>
            }
        </div>
    }
</section>
<section class="card sec"><h2>Phân công theo dự án (@teamProjects.Count)</h2>
    @if (teamProjects.Count > 0)
    {
        foreach (var pid in teamProjects)
        {
            var asg = mine.Where(a => a.ProjectId == pid).ToList();
            <div class="issue" style="grid-template-columns:22px 1fr auto">@Ui.Ptile(D.Tile(pid), D.PjName(pid), 22)<div><div class="t">@D.PjName(pid)</div><div class="m">@(string.Join(", ", asg.Select(a => D.PName(a.EmployeeId) + (a.Role == ProjectRole.Lead ? " (Leader)" : " (Hỗ trợ)"))))</div></div><span class="note">@asg.Count người</span></div>
        }
    }
    else
    {
        <p class="note">Chưa giao dự án nào.</p>
    }
</section>
