@model PlanningLeaveVm
@* Leader → Kế hoạch & duyệt → "Xin nghỉ" (yêu cầu 2026-10-20): tách riêng khỏi Kế hoạch đề xuất. Xin nghỉ của nhân viên trong nhóm, chia 2 mục Chờ duyệt / Đã duyệt (?f=pending|approved).
   Duyệt → ghi Nghỉ vào lịch (nghỉ nửa ngày / vài giờ vẫn làm việc phần còn lại); từ chối bắt buộc lý do. *@
@{
    var req = Context.Request;
    var pend = Model.Filter == "pending";
    var canWrite = Scope.CanLead && !Scope.IsReadOnly;
}
<partial name="_PlanningTabs" model="@("leave")" />
<partial name="_DayBar" />
@Ui.Seg(new[]
{
    (Ui.Here(req, ("f", "pending")), $"Chờ duyệt ({Model.PendingTotal})", pend, 0),
    (Ui.Here(req, ("f", "approved")), $"Đã duyệt ({Model.ApprovedTotal})", !pend, 0),
})
@if (Model.OtherPending.Count > 0)
{
    <p class="note" style="margin:0 0 8px">Còn chờ duyệt ở ngày khác: @foreach (var (od, oc) in Model.OtherPending) { <a class="link" href="@Ui.Here(req, ("d", Fmt.Key(od)), ("f", "pending"))">@Fmt.Dmy(od) (@oc)</a><text> </text> }</p>
}
@if (Model.Requests.Count == 0)
{
    <div class="empty">@(pend ? "Không có đề xuất xin nghỉ nào chờ duyệt ngày này." : "Chưa có đề xuất xin nghỉ nào đã xử lý ngày này.")</div>
}
else
{
    <section class="card sec"><h2>@(pend ? "Chờ duyệt" : "Đã xử lý") (@Model.Requests.Count)</h2>
        @foreach (var x in Model.Requests)
        {
            var who = D.PName(x.PersonId);
            var kind = (x.LeaveType == LeaveType.Paid ? "Nghỉ phép" : "Nghỉ không lương") + (x.LeaveSession is LeaveSession ls ? " · " + LeaveRules.Session(ls).Label : "");
            if (pend)
            {
                <div class="asg">
                    <div class="row"><b>@who</b><span class="note" style="margin-left:auto">@Fmt.Short(x.Date) · <span class="mono">@x.LeaveFrom–@x.LeaveTo</span></span></div>
                    <div class="t" style="margin-top:4px">@kind</div>
                    <div class="note">Lý do: @x.Reason</div>
                    @if (canWrite)
                    {
                        <div class="btn-row">
                            <form method="post" action="/Planning/DecideLeave" asp-antiforgery="true">
                                @Ui.ReturnField(req)
                                <input type="hidden" name="id" value="@x.Id"><input type="hidden" name="v" value="ok">
                                <button class="btn btn-ok">✓ Duyệt</button>
                            </form>
                            <form method="post" action="/Planning/DecideLeave" asp-antiforgery="true"
                                  data-prompt="Từ chối xin nghỉ của @who" data-prompt-label="Lý do từ chối" data-prompt-required data-prompt-name="note">
                                @Ui.ReturnField(req)
                                <input type="hidden" name="id" value="@x.Id"><input type="hidden" name="v" value="no">
                                <button class="btn btn-no">✕ Từ chối</button>
                            </form>
                        </div>
                    }
                </div>
            }
            else
            {
                var ok = x.Status == ExtraStatus.Approved;
                <div class="trow"><span class="ck @(ok ? "on" : "")">@(ok ? "✓" : "")</span>
                    <div><div class="t">@who · @kind</div>
                        <div class="s">@Fmt.Short(x.Date) · @x.LeaveFrom–@x.LeaveTo · Lý do: @x.Reason@(!ok && !string.IsNullOrEmpty(x.DecisionNote) ? " · Từ chối: " + x.DecisionNote : "")</div></div>
                    <span class="pill @(ok ? "p-ok" : "p-bad")">@(ok ? "Đã duyệt" : "Từ chối")</span></div>
            }
        }
    </section>
}
