@model PlanningOwnersVm
@* TP / Quản trị chọn Leader (nhóm) phụ trách từng dự án — có thống kê tổng quan (số dự án, từng Leader đang quản lý) và 2 mục Đã có Leader / Chưa có Leader
   (yêu cầu 2026-10-20). Leader được chọn sẽ thấy dự án ở tab "Leader dự án" (Leader chỉ thấy dự án được giao). *@
@{
    var req = Context.Request;
    var has = Model.Filter == "has";
}
@Ui.Head(0, "Leader phụ trách dự án")
@* Thống kê tổng quan *@
<div class="kpis k3">
    <div class="kpi k-info"><b>@Model.Total</b><span>Dự án đang triển khai</span></div>
    <div class="kpi k-ok"><b>@Model.Assigned</b><span>Đã có Leader</span></div>
    <div class="kpi @(Model.Unassigned > 0 ? "k-bad" : "k-idle")"><b>@Model.Unassigned</b><span>Chưa có Leader</span></div>
</div>
<section class="card sec">
    <h2>Leader đang quản lý</h2>
    <div class="tbl-wrap"><table><thead><tr><th>Leader</th><th class="n">Số dự án</th><th>Dự án</th></tr></thead><tbody>
        @foreach (var (l, ps) in Model.Stats)
        {
            <tr>
                <td><b>@l.Name</b><div class="note">nhóm @D.Team(l.Id).Count người</div></td>
                <td class="n"><b class="mono">@ps.Count</b></td>
                <td>@if (ps.Count == 0) { <span class="note">Chưa được giao dự án</span> } else { <details><summary class="link">Xem @ps.Count dự án</summary><ul class="otl">@foreach (var p in ps) { <li>@p.Name</li> }</ul></details> }</td>
            </tr>
        }
        <tr>
            <td><b>Chưa có Leader</b></td>
            <td class="n"><b class="mono @(Model.Unassigned > 0 ? "red" : "")">@Model.Unassigned</b></td>
            <td>@if (Model.Unassigned == 0) { <span class="note">Mọi dự án đã có Leader phụ trách</span> } else { <span class="note">Xem ở mục "Chưa có Leader" bên dưới</span> }</td>
        </tr>
    </tbody></table></div>
</section>
@* Ô tìm dự án: gõ chữ (không cần dấu) → hiện ngay các dự án khớp (tên, mã, khách hàng, địa điểm, Leader) kèm Leader phụ trách; tìm trong MỌI dự án kể cả đã hoàn thành.
   Không khớp = dự án chưa có trên hệ thống. Khi đang gõ thì ẩn danh sách theo mục (yêu cầu 2026-10-21). *@
<div style="margin:6px 0 10px">
    <input class="in" type="search" id="pjSearch" autocomplete="off" aria-label="Tìm dự án" list="pjNames">
    <datalist id="pjNames">@foreach (var p in Model.AllProjects) { <option value="@p.Name"></option> }</datalist>
    <p class="note" id="pjCount" style="margin:4px 0 0" hidden></p>
</div>
<div id="pjResults" hidden>
    @foreach (var p in Model.AllProjects) { <partial name="_OwnerCard" model="@((p, "pa", Model.Leaders))" /> }
    <div class="empty" id="pjNone" hidden>Chưa có dự án nào khớp trên hệ thống.</div>
</div>
<div id="pjList">
@Ui.Seg(new[]
{
    (Ui.Here(req, ("f", "has")), $"Đã có Leader ({Model.Assigned})", has, 0),
    (Ui.Here(req, ("f", "none")), $"Chưa có Leader ({Model.Unassigned})", !has, 0),
})
@if (Model.Projects.Count == 0)
{
    <div class="empty">@(has ? "Chưa có dự án nào được giao cho Leader." : "Mọi dự án đã có Leader phụ trách.")</div>
}
@foreach (var p in Model.Projects)
{
    <partial name="_OwnerCard" model="@((p, "po", Model.Leaders))" />
}
</div>
@section Scripts {
    <script>
    (function () {
        var q = document.getElementById('pjSearch'), res = document.getElementById('pjResults'), list = document.getElementById('pjList'),
            none = document.getElementById('pjNone'), cnt = document.getElementById('pjCount');
        if (!q) return;
        var cards = [].slice.call(res.querySelectorAll('[data-pj-key]'));
        // bỏ dấu tiếng Việt + chữ thường (khớp PlanningManage.Norm)
        function norm(s) { return (s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'd').toLowerCase(); }
        function run() {
            var t = norm(q.value).trim();
            if (!t) { res.hidden = true; cnt.hidden = true; list.hidden = false; return; }
            var words = t.split(/\s+/), n = 0;
            cards.forEach(function (c) {
                var k = c.getAttribute('data-pj-key'), ok = words.every(function (w) { return k.indexOf(w) >= 0; });
                c.hidden = !ok; if (ok) n++;
            });
            none.hidden = n > 0; res.hidden = false; list.hidden = true; cnt.hidden = false;
            cnt.textContent = n > 0 ? 'Tìm thấy ' + n + ' dự án' : 'Không tìm thấy — dự án này chưa có trên hệ thống';
        }
        q.addEventListener('input', run);
        run();
    })();
    </script>
}
