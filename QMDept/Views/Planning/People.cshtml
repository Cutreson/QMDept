@model PlanningPeopleVm
@* ldPeople(): danh sách nhân sự trong ngày đang chọn (Báo nghỉ / Bỏ nghỉ); TP: Sửa tài khoản (openPerson) + Tạo tài khoản (personForm). *@
@{
    var req = Context.Request;
    var d = Scope.Date;
    var isManager = Model.IsManager;
    var leaders = D.Leaders();
    var sub = isManager && req.Query["s"] == "create" ? "create" : "chart";
}
@if (Scope.Role == Role.Manager)
{
    @Ui.Head(0, "Nhân sự")
}
else
{
    <partial name="_PlanningTabs" model="@("people")" />
}
@if (isManager)
{
    @Ui.Seg(new[]
    {
        (Ui.Here(req, ("s", null)), "Sơ đồ tổ chức", sub == "chart", 0),
        (Ui.Here(req, ("s", "create")), "Tạo tài khoản", sub == "create", 0),
    })
}
@* Sơ đồ nhân sự hình tháp (yêu cầu 2026-10-19): Trưởng phòng → Leader → nhân viên của từng nhóm (+ cột "Chưa xếp nhóm").
   TP kéo thả thẻ nhân viên sang cột Leader khác (hoặc dùng ô chọn nhóm trên thẻ) → POST /Planning/MoveToTeam: nhân viên tự vào đúng nhóm. *@
@{
    var managers = D.Active.Where(x => x.Role == Role.Manager).OrderBy(x => x.SortOrder).ToList();
    var unassigned = D.Unassigned();
    var cols = leaders.Count + (unassigned.Count > 0 || isManager ? 1 : 0);
    var total = managers.Count + leaders.Count + leaders.Sum(l => D.Team(l.Id).Count) + unassigned.Count;
}
@if (sub == "chart")
{
<section class="card sec">
    <h2>@(isManager ? "Sơ đồ nhân sự" : "Sơ đồ nhân sự phòng") (@total)</h2>
    <div class="org" data-org="@(isManager ? "edit" : "view")" style="--n:@Math.Max(cols, 1)">
        <div class="org-top">
            @foreach (var m in managers) { <partial name="_OrgCard" model="m" /> }
        </div>
        <div class="org-stem"></div>
        <div class="org-row">
            @foreach (var l in leaders)
            {
                var team = D.Team(l.Id);
                <div class="org-col" data-leader="@l.Id">
                    <partial name="_OrgCard" model="l" />
                    <div class="org-staff">
                        @foreach (var s in team) { <partial name="_OrgCard" model="s" /> }
                        @if (team.Count == 0) { <div class="note org-empty">Chưa có nhân viên</div> }
                    </div>
                </div>
            }
            @if (unassigned.Count > 0 || isManager)
            {
                <div class="org-col none" data-leader="">
                    <div class="org-card plain"><b>Chưa xếp nhóm</b></div>
                    <div class="org-staff">
                        @foreach (var s in unassigned) { <partial name="_OrgCard" model="s" /> }
                        @if (unassigned.Count == 0) { <div class="note org-empty">Không có ai</div> }
                    </div>
                </div>
            }
        </div>
    </div>
    @if (isManager)
    {
        <form id="orgMove" method="post" action="/Planning/MoveToTeam" asp-antiforgery="true" hidden>
            @Ui.ReturnField(req)
            <input type="hidden" name="emp" value=""><input type="hidden" name="leaderId" value="">
        </form>
    }
</section>
}
@if (!isManager)
{
    return;
}
@* openPerson(p): mỗi người một <template> sheet "Sửa tài khoản". Nút "Xóa tài khoản này" gửi form ẩn epDel{id} (data-confirm) qua thuộc tính form=. *@
@if (sub == "chart") foreach (var p in Model.People)
{
    var self = p.Id == Scope.Account.Id;
    <template id="ep@(p.Id)">
        <form method="post" action="/Planning/EditAccount">
            @Html.AntiForgeryToken()
            @Ui.ReturnField(req)
            <input type="hidden" name="id" value="@p.Id">
            <h3>Sửa tài khoản</h3>
            <label class="f" for="epN" style="margin-top:0">Họ tên</label><input class="in" id="epN" name="name" value="@p.Name" maxlength="100" required>
            <div class="grid2"><div><label class="f" for="epC">Mã nhân viên</label><input class="in mono" id="epC" name="code" value="@p.Code" maxlength="@AccountRules.MaxCode" autocapitalize="none" required></div>
                <div><label class="f" for="epR">Vai trò</label>@Ui.Select("role", PlanningManage.Roles.Select(r => (r.ToString(), Labels.Title(r))), p.Role.ToString(), id: "epR")</div></div>
            <div class="grid2"><div><label class="f" for="epL">Nhóm (với nhân viên)</label><select class="in" id="epL" name="leaderId"><option value="">— Chưa xếp nhóm —</option>
                    @foreach (var x in leaders)
                    {
                        <option value="@x.Id" selected="@(p.LeaderId == x.Id)">Nhóm @x.Name</option>
                    }
                </select></div>
                <div><label class="f" for="epV">Cấp bậc (với nhân viên)</label><select class="in" id="epV" name="level"><option value="">— Chưa xếp —</option>
                    @foreach (var v in Labels.All<Level>())
                    {
                        <option value="@v" selected="@(p.Level == v)">@Labels.Of(v)</option>
                    }
                </select></div></div>
            <label class="row" style="margin-top:12px;font-size:13px"><input type="checkbox" id="epP" name="resetPassword" value="true"> Đặt lại mật khẩu (người này đặt mật khẩu mới ở lần đăng nhập tới)</label>
            <label class="row" style="margin-top:8px;font-size:13px"><input type="checkbox" name="hrDuty" value="true" checked="@p.HrDuty"> Phụ trách nhân sự, báo cơm, làm thêm tại công ty (với Leader)</label>
            @if (!self)
            {
                <button type="submit" class="link" form="epDel@(p.Id)" style="color:var(--bad);margin-top:12px">Xóa tài khoản này</button>
            }
            <div class="btn-row" style="margin-top:14px"><button type="button" class="btn" data-x="close">Hủy</button><button class="btn btn-primary">Lưu</button></div>
        </form>
    </template>
    if (!self)
    {
        <form id="epDel@(p.Id)" method="post" action="/Planning/DeleteAccount" asp-antiforgery="true" hidden data-confirm="Xóa tài khoản @p.Name? Lịch sử công việc vẫn giữ." data-confirm-label="Xóa">@Ui.ReturnField(req)<input type="hidden" name="id" value="@p.Id"></form>
    }
}
@* personForm *@
@if (sub == "create")
{
<form id="personForm" class="card sec" method="post" action="/Planning/CreateAccount" asp-antiforgery="true">
    <h2>Tạo tài khoản</h2>
    @Ui.ReturnField(req)
    <div class="grid2">
        <div><label class="f" for="npN" style="margin-top:0">Họ tên</label><input class="in" id="npN" name="name" maxlength="100" required></div>
        <div><label class="f" for="npC" style="margin-top:0">Mã nhân viên</label><input class="in mono" id="npC" name="code" maxlength="@AccountRules.MaxCode" autocapitalize="none"></div>
        <div><label class="f" for="npR">Vai trò</label>@Ui.Select("role", PlanningManage.Roles.Select(r => (r.ToString(), Labels.Title(r))), Role.Staff.ToString(), id: "npR")</div>
        <div><label class="f" for="npL">Nhóm (với nhân viên)</label><select class="in" id="npL" name="leaderId"><option value="">— Chưa xếp nhóm —</option>
            @foreach (var x in leaders)
            {
                <option value="@x.Id">Nhóm @x.Name</option>
            }
        </select></div>
        <div><label class="f" for="npV">Cấp bậc (với nhân viên)</label><select class="in" id="npV" name="level"><option value="">— Chưa xếp —</option>
            @foreach (var v in Labels.All<Level>())
            {
                <option value="@v">@Labels.Of(v)</option>
            }
        </select></div>
        <div><label class="f" for="npP">Mật khẩu</label><input class="in mono" id="npP" name="password" value="@AccountRules.DefaultPassword" maxlength="64" autocomplete="off"></div>
    </div>
    <button class="btn btn-primary btn-block">Tạo tài khoản</button>
</form>
}
