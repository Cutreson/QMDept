@* ldOverview(): KPI, thông báo chờ duyệt (goLdApprove), tình hình dự án (pjTable), donut, phát sinh hôm nay.
   Controller đã EnsureAsync(Date, Date+1). *@
@{
    var req = Context.Request;
    var d = Scope.Date;
    var k = D.Kpis(d);
    var xs = D.ExtrasOn(d);
    var pend = D.Plans.Count(p => p.Date == d && Dept.PlanSt(p) == PlanState.Pending && D.IsTeamStaff(p.EmployeeId));
    var xp = xs.Count(x => x.Status == ExtraStatus.Pending);
    var rp = D.Reports.Count(r => r.Date == d && Dept.EodSt(r) == EodState.Pending && D.IsTeamStaff(r.EmployeeId));
}
<partial name="_OverviewTabs" model="@(ViewData["Section"] as string ?? "projects")" />
<partial name="_DayBar" />
@if (ViewData["Section"] as string == "people")
{
    @* Mục Nhân sự: bảng nhóm của Leader (Leader + nhân viên nhóm mình) — yêu cầu 2026-10-20 *@
    var rows = new List<(Person P, string Group)>();
    if (Scope.Account.HrDuty)
    {
        // Leader được giao quản lý nhân sự / báo cơm / làm thêm (yêu cầu 2026-10-21): bảng nhân sự CẢ PHÒNG như Trưởng phòng
        foreach (var m in D.Active.Where(x => x.Role == Role.Manager).OrderBy(x => x.SortOrder)) rows.Add((m, "Trưởng phòng"));
        foreach (var l in D.Leaders())
        {
            rows.Add((l, "Leader"));
            foreach (var s in D.Team(l.Id)) rows.Add((s, "Nhóm " + l.Name));
        }
        foreach (var s in D.Unassigned()) rows.Add((s, "Chưa xếp nhóm"));
    }
    else
    {
        rows.Add((Scope.Account, "Leader"));
        foreach (var s in D.Team(Scope.Account.Id)) rows.Add((s, "Nhóm " + Scope.Account.Name));
    }
    <partial name="_PeopleTable" model="rows" />
    return;
}
<div class="kpis"><div class="kpi k-info"><b>@k.Projects</b><span>Dự án</span></div><div class="kpi k-info"><b>@k.Working/@k.Total</b><span>Nhân sự</span></div>
    <div class="kpi k-ok"><b>@k.C.Done</b><span>Hoàn thành</span></div><div class="kpi k-warn"><b>@k.C.InProgress</b><span>Đang làm</span></div><div class="kpi k-bad"><b>@k.C.Late</b><span>Chậm</span></div></div>
@if (pend > 0 || xp > 0 || rp > 0)
{
    @* goLdApprove → Kế hoạch & duyệt / Kế hoạch, lọc "Chờ duyệt" *@
    <a class="notice" href="@Ui.To(req, "/Planning/Approvals", ("ap", "pending"))" style="--nbg:var(--warn-soft);--nfg:var(--warn);border:0;width:100%;text-align:left"><span class="ic">!</span><div><b>@pend kế hoạch ngày · @rp báo cáo cuối ngày · @xp phát sinh đang chờ bạn duyệt</b></div></a>
}
<section class="card sec"><h2>Tình hình dự án</h2>@D.PjTable(d)</section>
<section class="card sec"><h2>Công việc hôm nay</h2>@Blocks.Donut(k.C)</section>
<section class="card sec"><h2>Công việc phát sinh</h2>
    @if (xs.Count > 0)
    {
        foreach (var x in xs) { @D.ExtraRow(x) }
    }
    else
    {
        <p class="note">Chưa có phát sinh hôm nay.</p>
    }
</section>
