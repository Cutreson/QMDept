@model ManagerProjectsVm
@* tpProjects(): chip mọi dự án (?pj=) + projectDetail(pid, 'tp') (tab con ?tab=overview|plan|people giữ nguyên khi đổi dự án). *@
@{
    ViewData["Title"] = "Dự án";
    var req = Context.Request;
}
@if (Model.Detail is null)
{
    @Ui.Head(0, "Chi tiết dự án", "")
    <div class="empty">Chưa có dự án.</div>
    @if (!Scope.IsViewingOther)
    {
        <a class="btn btn-primary btn-block" href="@Ui.To(req, "/Planning/Projects", ("pj", "new"))">＋ Dự án mới</a>
    }
}
else
{
    @Ui.Head(0, "Dự án")
    @if (!Scope.IsViewingOther)
    {
        <div class="row" style="margin-top:0;gap:8px">
            <a class="btn btn-primary" href="@Ui.To(req, "/Planning/Projects", ("pj", "new"))">＋ Dự án mới</a>
            <a class="btn" href="@Ui.To(req, "/Planning/Projects", ("pj", Model.Pid.ToString()))">Sửa dự án &amp; đầu mục</a>
            <a class="btn" href="@Ui.To(req, "/Planning/ProjectOwners")">Leader phụ trách dự án</a>
        </div>
    }
    <p class="note" style="margin:14px 0 0"><b>@D.PjCountText(Model.Projects, Scope.Date)</b></p>
    @if (Model.Projects.Count > 12)
    {
        @* Nhiều dự án: ô chọn có tìm kiếm thay cho hàng nút (data-nav → mở trang của dự án đã chọn) *@
        <select class="in" data-nav aria-label="Chọn dự án" style="margin-top:8px">
            @foreach (var x in Model.Projects)
            {
                <option value="@Ui.Here(req, ("pj", x.Id.ToString()))" selected="@(x.Id == Model.Pid)">@(string.IsNullOrEmpty(x.Code) ? x.Name : x.Code + " · " + x.Name)</option>
            }
        </select>
    }
    else
    {
        <div class="pchips" style="margin-top:8px">
            @foreach (var x in Model.Projects)
            {
                <a class="pchip" href="@Ui.Here(req, ("pj", x.Id.ToString()))" aria-pressed="@(x.Id == Model.Pid ? "true" : "false")">@x.Name</a>
            }
        </div>
    }
    <partial name="_ProjectDetail" model="Model.Detail" />
}
