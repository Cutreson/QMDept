@model ManagerApprovalsVm
@* tpApprove(): Hỗ trợ nhân sự (kế hoạch cần TP duyệt — tpDecide) / Phát sinh (chỉ theo dõi, Leader duyệt). *@
@{
    ViewData["Title"] = "Phê duyệt";
    var req = Context.Request;
}
@Ui.Head(2, "Chi tiết & phê duyệt")
<partial name="_MgrApprovalTabs" model="@Model.Mode" />
@* Mục nhỏ bấm chọn: Chờ duyệt → Đã duyệt → Từ chối (thay ô chọn Trạng thái; yêu cầu 2026-10-20) *@
@Ui.Seg(new[]
{
    (Ui.Here(req, ("f", null)), "Chờ duyệt", Model.Filter is not ("approved" or "rejected"), Model.Mode == "plan" ? Model.PendingManager : Model.Mode == "leader" ? Model.PendingLeader : 0),
    (Ui.Here(req, ("f", "approved")), "Đã duyệt", Model.Filter == "approved", 0),
    (Ui.Here(req, ("f", "rejected")), "Từ chối", Model.Filter == "rejected", 0),
})

@if (Model.Mode == "plan")
{
    <partial name="_DayBar" />
    if (Model.Plans.Count == 0)
    {
        <div class="empty">Không có yêu cầu hỗ trợ nhân sự phù hợp bộ lọc.</div>
    }
    foreach (var p in Model.Plans)
    {
        var st = Dept.PlanSt(p);
        var name = D.PName(p.EmployeeId);
        <section class="card apv">
            <div class="hd">@Ui.Av(name)<b>@name</b>@Ui.Pill(st)</div>
            <p class="note" style="margin:0 0 8px">@(string.IsNullOrEmpty(p.LeaderBy) ? D.ApproverName(D.P(p.EmployeeId)) : p.LeaderBy): @(p.LeaderDecision is Decision ld ? (ld == Decision.Ok ? "đã duyệt" : "từ chối") + " lúc " + VnTime.Stamp(p.LeaderAt) : "chưa duyệt")</p>
            @Blocks.PlanMeta(p)
            @D.PlanTable(p)
            @if (!string.IsNullOrEmpty(p.Note))
            {
                <div class="cmt"><b>Nhân viên:</b> @p.Note</div>
            }
            @if (!string.IsNullOrEmpty(p.LeaderNote))
            {
                <div class="cmt"><b>Leader:</b> @p.LeaderNote</div>
            }
            @if (!string.IsNullOrEmpty(p.ManagerNote))
            {
                <div class="cmt"><b>TP:</b> @p.ManagerNote</div>
            }
            @if (st == PlanState.Pending)
            {
                <p class="note" style="margin:0">Đang chờ @D.ApproverName(D.P(p.EmployeeId)) duyệt trước.</p>
            }
            @if (st == PlanState.PendingManager)
            {
                <div class="btn-row">
                    <form method="post" action="/Manager/Decide" asp-antiforgery="true"
                          data-prompt="Từ chối kế hoạch của @name" data-prompt-label="Lý do" data-prompt-required
                          data-prompt-name="note" data-prompt-value="@p.ManagerNote">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@p.Id">
                        <input type="hidden" name="v" value="no">
                        <button class="btn btn-no">Từ chối</button>
                    </form>
                    <form method="post" action="/Manager/Decide" asp-antiforgery="true">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@p.Id">
                        <input type="hidden" name="v" value="ok">
                        <button class="btn btn-ok">Duyệt</button>
                    </form>
                </div>
            }
        </section>
    }
}
else if (Model.Mode == "extra")
{
    <partial name="_DayBar" />
    if (Model.Extras.Count == 0)
    {
        <div class="empty">Không có phát sinh phù hợp bộ lọc.</div>
    }
    foreach (var x in Model.Extras)
    {
        var xst = D.ExSt(x);
        <section class="card apv">
            <div class="hd"><span class="av" style="background:@Labels.Color(xst);color:#fff">!</span><b>@x.Title</b>@Ui.Pill(xst)</div>
            <div style="font-size:13px;display:grid;gap:2px;margin-bottom:10px">
                <div><span class="muted">Dự án:</span> @D.PjName(x.ProjectId)</div>
                <div><span class="muted">Người đề xuất:</span> @D.PName(x.EmployeeId)</div>
                <div><span class="muted">Thời gian:</span> <span class="mono">@Fmt.Dmy(x.Date) @(x.Start ?? "")@(string.IsNullOrEmpty(x.End) ? "" : "–" + x.End)</span></div>
                @if (!string.IsNullOrEmpty(x.Description))
                {
                    <div><span class="muted">Mô tả:</span> @x.Description</div>
                }
                @if (!string.IsNullOrEmpty(x.DecidedBy))
                {
                    <div class="note">@(x.Status == ExtraStatus.Rejected ? "Từ chối" : "Duyệt") bởi @x.DecidedBy lúc @VnTime.Stamp(x.DecidedAt)</div>
                }
                @if (!string.IsNullOrEmpty(x.Reason))
                {
                    <div class="note red">Lý do: @x.Reason</div>
                }
            </div>
            @if (x.Status == ExtraStatus.Pending)
            {
                <p class="note" style="margin:0">Chờ @D.ApproverName(D.P(x.EmployeeId)) duyệt.</p>
            }
        </section>
    }
}
else if (Model.Mode == "leader")
{
    @* Trạng thái làm việc trong ngày của Leader (Leader tự gửi → Trưởng phòng duyệt) — yêu cầu 2026-10-16 *@
    <partial name="_DayBar" />
    @* Báo cáo cuối ngày của Leader: Trưởng phòng duyệt cuối cùng (yêu cầu 2026-10-29, thay "tự xác nhận / chỉ xem" của 2026-10-24) *@
    var leaderReports = D.Reports.Where(r => r.Date == Scope.Date && D.P(r.EmployeeId) is { Role: Role.Leader }
            && (Model.Filter == "approved" ? Dept.EodSt(r) == EodState.Approved : Model.Filter == "rejected" ? Dept.EodSt(r) == EodState.Rejected : Dept.EodSt(r) == EodState.Pending))
        .OrderBy(r => D.PName(r.EmployeeId), Fmt.ViCompare).ToList();
    foreach (var lr in leaderReports)
    {
        var lname = D.PName(lr.EmployeeId);
        var lts = D.Chosen(lr.Date, lr.EmployeeId); var lc = Dept.Count(lts);
        var lst = Dept.EodSt(lr);
        <section class="card apv">
            <div class="hd">@Ui.Av(lname)<b>@lname <span class="note mono">báo cáo cuối ngày · gửi @VnTime.Stamp(lr.SentAt)</span></b>@Ui.Pill(lst)</div>
            <div class="pmeta">
                <span>Hoàn thành <b class="mono">@lc.Done/@lts.Count</b></span>
                @if (lc.Late > 0) { <span class="pill p-bad">@lc.Late chậm</span> }
                @if (lr.Blocked) { <span class="pill p-bad">Có vướng mắc</span> }
            </div>
            @if (lts.Count == 0) { <p class="note">Không có việc nào được chọn.</p> }
            @foreach (var t in lts)
            {
                var nx = PlanningReportsVm.NextOf(D, t);
                @D.TaskRow(t)
                if (!string.IsNullOrEmpty(t.Note))
                {
                    <div class="note" style="margin:-4px 0 6px 44px">@(t.Status == TaskState.Done ? "Kết quả" : "Lý do chưa hoàn thành"): @t.Note</div>
                }
                if (nx is not null)
                {
                    <div class="nx-line" style="margin:0 0 8px 44px">Kế hoạch chuyển: <b>@Fmt.WDS[Fmt.Wday(nx.Date)] @Fmt.Dmy(nx.Date)</b> <span class="mono">@nx.Start–@nx.End</span> · @nx.Title</div>
                }
            }
            @if (!string.IsNullOrEmpty(lr.Note)) { <div class="cmt" style="margin-top:8px"><b>Ghi chú của Leader:</b> @lr.Note</div> }
            @if (!string.IsNullOrEmpty(lr.LeaderNote)) { <div class="cmt"><b>Góp ý của Trưởng phòng:</b> @lr.LeaderNote</div> }
            @if (lr.LeaderDecision is null)
            {
                <div class="btn-row" style="margin-top:8px">
                    <form method="post" action="/Manager/DecideLeaderReport" asp-antiforgery="true"
                          data-prompt="Yêu cầu @lname bổ sung báo cáo" data-prompt-label="Nội dung cần bổ sung" data-prompt-required data-prompt-name="note">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@lr.Id"><input type="hidden" name="v" value="no">
                        <button class="btn btn-no">Yêu cầu bổ sung</button>
                    </form>
                    <form method="post" action="/Manager/DecideLeaderReport" asp-antiforgery="true">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@lr.Id"><input type="hidden" name="v" value="ok">
                        <button class="btn btn-ok">✓ Duyệt</button>
                    </form>
                </div>
            }
            else
            {
                <div class="note" style="margin:1em 0 0">@(string.IsNullOrEmpty(lr.LeaderBy) ? "Trưởng phòng" : lr.LeaderBy) @(lst == EodState.Approved ? "đã duyệt" : "yêu cầu bổ sung") lúc @VnTime.Stamp(lr.LeaderAt)
                    @if (lr.LeaderBy != "Tự xác nhận")
                    {
                        <form method="post" action="/Manager/UndoLeaderReport" class="inline" asp-antiforgery="true">
                            @Ui.ReturnField(req)
                            <input type="hidden" name="id" value="@lr.Id">
                            <button class="link">Hoàn tác</button>
                        </form>
                    }
                </div>
            }
        </section>
    }
    if (Model.LeaderNotSentPlan.Count > 0 && Model.Filter != "approved" && Model.Filter != "rejected")
    {
        <p class="note">Chưa khai báo trạng thái làm việc: @string.Join(", ", Model.LeaderNotSentPlan.Select(p => p.Name))</p>
    }
    if (Model.LeaderPlans.Count == 0 && Model.LeaderLeaves.Count == 0 && leaderReports.Count == 0)
    {
        <div class="empty">Không có trạng thái làm việc / báo cáo của Leader phù hợp bộ lọc.</div>
    }
    if (Model.LeaderLeaves.Count > 0)
    {
        @* Xin nghỉ của Leader (nằm trong Đề xuất công việc): TP duyệt → ghi Nghỉ vào lịch; từ chối bắt buộc lý do (yêu cầu 2026-10-20) *@
        <section class="card sec"><h2>Xin nghỉ của Leader (@Model.LeaderLeaves.Count)</h2>
            @foreach (var x in Model.LeaderLeaves)
            {
                var who = D.PName(x.PersonId);
                var kind = (x.LeaveType == LeaveType.Paid ? "Nghỉ phép" : "Nghỉ không lương") + (x.LeaveSession is LeaveSession ls ? " · " + LeaveRules.Session(ls).Label : "");
                if (x.Status == ExtraStatus.Pending)
                {
                    <div class="asg">
                        <div class="row"><b>@who</b><span class="note" style="margin-left:auto">@Fmt.Short(x.Date) · <span class="mono">@x.LeaveFrom–@x.LeaveTo</span></span></div>
                        <div class="t" style="margin-top:4px">@kind</div>
                        <div class="note">Lý do: @x.Reason</div>
                        <div class="note mono">@Ui.Timeline("Gửi", x.CreatedAt)</div>
                        <div class="btn-row">
                            <form method="post" action="/Manager/DecideLeave" asp-antiforgery="true">
                                @Ui.ReturnField(req)
                                <input type="hidden" name="id" value="@x.Id"><input type="hidden" name="v" value="ok">
                                <button class="btn btn-ok">✓ Duyệt</button>
                            </form>
                            <form method="post" action="/Manager/DecideLeave" asp-antiforgery="true"
                                  data-prompt="Từ chối xin nghỉ của @who" data-prompt-label="Lý do từ chối" data-prompt-required data-prompt-name="note">
                                @Ui.ReturnField(req)
                                <input type="hidden" name="id" value="@x.Id"><input type="hidden" name="v" value="no">
                                <button class="btn btn-no">✕ Từ chối</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    var ok = x.Status == ExtraStatus.Approved;
                    <div class="trow"><span class="ck @(ok ? "on" : "")">@(ok ? "✓" : "")</span>
                        <div><div class="t">@who · @kind</div>
                            <div class="s">@Fmt.Short(x.Date) · @x.LeaveFrom–@x.LeaveTo · Lý do: @x.Reason@(!ok && !string.IsNullOrEmpty(x.DecisionNote) ? " · Từ chối: " + x.DecisionNote : "")</div>
                            <div class="s mono">@Ui.Timeline("Gửi", x.CreatedAt, x.DecidedBy, ok ? "duyệt" : "từ chối", x.DecidedAt)</div></div>
                        <span class="pill @(ok ? "p-ok" : "p-bad")">@(ok ? "Đã duyệt" : "Từ chối")</span></div>
                }
            }
        </section>
    }
    foreach (var p in Model.LeaderPlans)
    {
        var st = Dept.PlanSt(p);
        var name = D.PName(p.EmployeeId);
        <section class="card apv">
            <div class="hd">@Ui.Av(name)<b>@name <span class="note mono">trạng thái làm việc · gửi @VnTime.Stamp(p.SentAt)</span></b>@Ui.Pill(st)</div>
            @Blocks.PlanMeta(p)
            @D.PlanTable(p)
            @if (!string.IsNullOrEmpty(p.Note))
            {
                <div class="cmt"><b>Leader ghi chú:</b> @p.Note</div>
            }
            @if (!string.IsNullOrEmpty(p.LeaderNote))
            {
                <div class="cmt"><b>Ý kiến TP:</b> @p.LeaderNote</div>
            }
            @if (p.LeaderDecision is null)
            {
                <div class="btn-row">
                    <form method="post" action="/Manager/DecideLeaderPlan" asp-antiforgery="true"
                          data-prompt="Từ chối trạng thái làm việc của @name" data-prompt-label="Lý do / hướng dẫn sửa" data-prompt-required
                          data-prompt-name="note">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@p.Id"><input type="hidden" name="v" value="no">
                        <button class="btn btn-no">Từ chối</button>
                    </form>
                    <form method="post" action="/Manager/DecideLeaderPlan" asp-antiforgery="true">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@p.Id"><input type="hidden" name="v" value="ok">
                        <button class="btn btn-ok">Duyệt</button>
                    </form>
                </div>
            }
            else
            {
                <div class="row" style="justify-content:space-between">
                    <span class="note">@(p.LeaderDecision == Decision.Ok ? "Đã duyệt" : "Đã từ chối") lúc @VnTime.Stamp(p.LeaderAt)</span>
                    <form method="post" action="/Manager/UndoLeaderPlan" class="inline" asp-antiforgery="true">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@p.Id">
                        <button class="btn btn-sm">Hoàn tác</button>
                    </form>
                </div>
            }
        </section>
    }
}
