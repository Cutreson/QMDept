@model KhTuanVm
@* ldWeek(): Lịch tuần — bảng NV × 7 ngày, việc từng ngày của NV đang chọn (?emp=), form thêm việc (wkForm). *@
@{
    var req = Context.Request;
    var emp = Model.Emp;
}
<partial name="_KeHoachTabs" model="@("tuan")" />
@if (emp is null)
{
    <div class="empty">Chưa có nhân viên. Thêm ở tab Nhân sự.</div>
    return;
}
<partial name="_WeekBar" />
<form method="get" action="@req.Path">
    @foreach (var kv in req.Query.Where(k => k.Key != "emp"))
    {
        <input type="hidden" name="@kv.Key" value="@kv.Value">
    }
    <label class="row" style="margin-bottom:12px"><span class="note">Nhân viên:</span>
        @Ui.Select("emp", Model.Staff.Select(p => (p.Id.ToString(), p.Name)), emp.Id.ToString(), id: "ldWkEmp", extraAttrs: "data-autosubmit")</label>
</form>
<div class="tbl-wrap card" style="margin-bottom:12px"><table><thead><tr><th>Nhân viên</th>
    @foreach (var d in Model.Days)
    {
        <th class="n">@Fmt.WDS[Fmt.Wday(d)]<br>@Fmt.Dm(d)</th>
    }
    </tr></thead><tbody>
    @foreach (var p in Model.Staff)
    {
        <tr><td><a class="link" href="@Ui.Here(req, ("emp", p.Id.ToString()))" style="color:@(p.Id == emp.Id ? "var(--brand)" : "var(--fg)")">@p.Name</a></td>
            @foreach (var d in Model.Days)
            {
                var n = D.TasksOn(d, p.Id).Count;
                var lv = D.OnLeave(d, p.Id);
                <td class="n @(lv is not null ? "red" : "")">@(lv is not null ? "Nghỉ" : n > 0 ? n.ToString() : "·")</td>
            }
        </tr>
    }
    </tbody></table></div>
@foreach (var d in Model.Days)
{
    var ts = D.TasksOn(d, emp.Id);
    if (ts.Count == 0) { continue; }
    <section class="card wday"><h3>@Fmt.WD[Fmt.Wday(d)] – @Fmt.Dm(d) (@ts.Count)</h3>
        @foreach (var x in ts)
        {
            var done = x.Status == TaskState.HoanThanh;
            <div class="trow"><span class="ck @(done ? "on" : "")">@(done ? "✓" : "")</span><div><div class="t">@x.Title</div><div class="s">@D.PjName(x.ProjectId) · @Labels.Of(x.Status)</div></div>
                <span class="tm">@x.Start–@x.End <form method="post" action="/KeHoach/XoaViec" asp-antiforgery="true" class="inline" data-confirm="Xóa “@x.Title” khỏi lịch?" data-confirm-label="Xóa">@Ui.ReturnField(req)<input type="hidden" name="id" value="@x.Id"><button class="link" aria-label="Xóa việc" style="color:var(--bad);margin-left:6px">✕</button></form></span></div>
        }
    </section>
}
<form id="wkForm" class="card sec" method="post" action="/KeHoach/ThemViecTuan" asp-antiforgery="true">
    <h2>Thêm việc cho @emp.Name</h2>
    @Ui.ReturnField(req)
    <input type="hidden" name="emp" value="@emp.Id">
    <partial name="_TaskFields" model="@(new TaskFieldsVm { Prefix = "w", ProjectId = D.MainProject(emp.Id, Scope.Date), Dates = Model.Days, SelectedDate = Scope.Date })" />
    <button class="btn btn-primary btn-block" style="margin-top:12px">Thêm vào lịch tuần</button>
</form>
<partial name="_ItemsJson" />
