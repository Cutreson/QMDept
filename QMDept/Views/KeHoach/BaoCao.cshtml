@model KhBaoCaoVm
@* Leader → Kế hoạch & duyệt → Báo cáo: port ldEodApprove() + carrySection(d)
   (+ handler eodDecide / eodUndo / carryOk / carryAll / carryUndo / eodCarry). Controller nạp [ngày, ngày + 14]. *@
@{
    var req = Context.Request;
    var d = Scope.Date;
    var canWrite = Scope.CanLead && !Scope.IsReadOnly;
}
<partial name="_KeHoachTabs" model="@("bc")" />
<partial name="_DayBar" />

@* ---------- carrySection(d) ---------- *@
@if (Model.Carries.Count > 0)
{
    var pend = Model.CarryPending;
    <section class="card sec">
        <h2><span class="grow">Đề xuất chuyển kế hoạch (@pend chờ duyệt)</span>
            @if (pend > 1 && canWrite)
            {
                <form method="post" action="/KeHoach/DuyetTatCaChuyen" class="inline" asp-antiforgery="true">
                    @Ui.ReturnField(req)
                    <input type="hidden" name="date" value="@Fmt.Key(d)">
                    <button class="btn btn-sm btn-ok">Duyệt tất cả</button>
                </form>
            }
        </h2>
        @foreach (var n in Model.Carries)
        {
            var o = D.Task(n.CarriedFromId);
            var name = D.PName(n.EmployeeId);
            <div class="issue">@Ui.Av(name, style: "width:24px;height:24px;font-size:10px")<div><div class="t">@name</div>
                @if (o is not null)
                {
                    <div class="m">Việc chưa xong: @o.Title · @Labels.Of(o.Status)@(string.IsNullOrEmpty(o.Note) ? "" : " — " + o.Note)</div>
                }
                <div class="m">→ <b style="color:var(--fg)">@Fmt.WD[Fmt.Wday(n.Date)] @Fmt.Dm(n.Date)</b> <span class="mono">@n.Start–@n.End</span> · @n.Title@(string.IsNullOrEmpty(n.EditedBy) ? "" : " · " + n.EditedBy + " đã chỉnh")</div></div>
                <div style="display:grid;gap:4px;justify-items:end">
                    @if (n.CarryOk)
                    {
                        <span class="pill p-ok">Đã duyệt</span>
                        if (canWrite)
                        {
                            <form method="post" action="/KeHoach/HoanTacChuyen" class="inline" asp-antiforgery="true">
                                @Ui.ReturnField(req)
                                <input type="hidden" name="id" value="@n.Id">
                                <button class="link">Hoàn tác</button>
                            </form>
                        }
                    }
                    else if (canWrite)
                    {
                        <form method="post" action="/KeHoach/DuyetChuyen" class="inline" asp-antiforgery="true">
                            @Ui.ReturnField(req)
                            <input type="hidden" name="id" value="@n.Id">
                            <button class="btn btn-sm btn-ok">Duyệt</button>
                        </form>
                        <button type="button" class="btn btn-sm" data-sheet="khCarry@(n.Id)">Sửa</button>
                    }
                </div></div>
        }
        <p class="note" style="margin-bottom:0">Việc chỉ vào lịch của nhân viên sau khi Leader duyệt. "Sửa" lưu thay đổi và duyệt luôn.</p>
    </section>
}

@if (Model.NotSent.Count > 0)
{
    <p class="note">Chưa gửi báo cáo cuối ngày: @string.Join(", ", Model.NotSent.Select(p => p.Name))</p>
}

@* ---------- ldEodApprove(): báo cáo cuối ngày ---------- *@
@if (Model.Reports.Count == 0)
{
    <div class="empty">Chưa có nhân viên gửi báo cáo cuối ngày này.</div>
}
@foreach (var r in Model.Reports)
{
    var st = Dept.EodSt(r);
    var name = D.PName(r.EmployeeId);
    var ts = D.Chosen(d, r.EmployeeId);
    var c = Dept.Count(ts);
    var xs = D.ExtrasOn(d).Count(x => x.EmployeeId == r.EmployeeId);
    <section class="card apv">
        <div class="hd">@Ui.Av(name)<b>@name <span class="note mono">gửi @VnTime.Hm(r.SentAt)</span></b>@Ui.Pill(st)</div>
        <div class="pmeta">
            <span>Hoàn thành <b class="mono">@c.HoanThanh/@ts.Count</b></span>
            @if (c.Cham > 0)
            {
                <span class="pill p-bad">@c.Cham chậm</span>
            }
            @if (r.Blocked)
            {
                <span class="pill p-bad">Có vướng mắc</span>
            }
            @if (xs > 0)
            {
                <span>@xs phát sinh</span>
            }
        </div>
        @if (ts.Count == 0)
        {
            <p class="note">Không có việc nào được chọn.</p>
        }
        @foreach (var t in ts)
        {
            var n = KhBaoCaoVm.NextOf(D, t);
            @D.TaskRow(t)
            if (!string.IsNullOrEmpty(t.Note))
            {
                <div class="note" style="margin:-4px 0 6px 44px">@(t.Status == TaskState.HoanThanh ? "Kết quả" : "Lý do chưa hoàn thành"): @t.Note</div>
            }
            if (n is not null)
            {
                <div class="nx-line row" style="margin:0 0 8px 44px;align-items:flex-start">
                    <div style="flex:1">Đề xuất chuyển: <b>@Fmt.WDS[Fmt.Wday(n.Date)] @Fmt.Dm(n.Date)</b> <span class="mono">@n.Start–@n.End</span> · @n.Title
                        @if (!string.IsNullOrEmpty(n.EditedBy))
                        {
                            <div class="note">@n.EditedBy đã chỉnh</div>
                        }
                    </div>
                    @if (canWrite && KhBaoCaoVm.CanEditCarry(n))
                    {
                        <button type="button" class="btn btn-sm" data-sheet="khCarry@(n.Id)">Sửa</button>
                    }
                </div>
            }
        }
        @if (!string.IsNullOrEmpty(r.Note))
        {
            <div class="cmt" style="margin-top:8px"><b>Ghi chú nhân viên:</b> @r.Note</div>
        }
        @if (!string.IsNullOrEmpty(r.LeaderNote))
        {
            <div class="cmt"><b>Góp ý Leader:</b> @r.LeaderNote</div>
        }
        @if (r.LeaderDecision is null)
        {
            if (canWrite)
            {
                <div class="btn-row" style="margin-top:8px">
                    <form method="post" action="/KeHoach/QuyetDinhBaoCao" asp-antiforgery="true"
                          data-prompt="Yêu cầu @name bổ sung báo cáo" data-prompt-label="Nội dung cần bổ sung" data-prompt-required
                          data-prompt-name="note" data-prompt-value="@r.LeaderNote">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@r.Id"><input type="hidden" name="v" value="no">
                        <button class="btn btn-no">Yêu cầu bổ sung</button>
                    </form>
                    <form method="post" action="/KeHoach/QuyetDinhBaoCao" asp-antiforgery="true">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@r.Id"><input type="hidden" name="v" value="ok">
                        <button class="btn btn-ok">✓ Duyệt</button>
                    </form>
                </div>
            }
        }
        else
        {
            <div class="note" style="margin:1em 0 0">@(string.IsNullOrEmpty(r.LeaderBy) ? "Leader" : r.LeaderBy) @(st == EodState.DaDuyet ? "đã duyệt" : "yêu cầu bổ sung") lúc @VnTime.Hm(r.LeaderAt)
                @if (canWrite)
                {
                    <form method="post" action="/KeHoach/HoanTacBaoCao" class="inline" asp-antiforgery="true">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@r.Id">
                        <button class="link">Hoàn tác</button>
                    </form>
                }
            </div>
        }
    </section>
}

@* ---------- eodCarry: sheet "Chỉnh kế hoạch tiếp theo" cho từng việc chuyển tiếp ---------- *@
@if (canWrite)
{
    foreach (var n in Model.SheetTasks)
    {
        var days = KhDuyet.CarryDays(n);
        <template id="khCarry@(n.Id)">
            <form method="post" action="/KeHoach/SuaChuyen">
                @Html.AntiForgeryToken()
                @Ui.ReturnField(req)
                <input type="hidden" name="id" value="@n.Id">
                <h3>Chỉnh kế hoạch tiếp theo</h3>
                <p class="note" style="margin:0 0 8px">@D.PName(n.EmployeeId) · chuyển tiếp từ @Fmt.Dm(n.FromDate)</p>
                <label class="f" for="cD" style="margin-top:0">Chuyển sang ngày</label>
                @Ui.Select("date", days.Select(x => (Fmt.Key(x), KhDuyet.CarryDayLabel(x))), Fmt.Key(n.Date), id: "cD")
                <div class="pick2 eq">
                    <div><label class="f" for="cS">Bắt đầu</label>@Ui.TimeSelect("start", n.Start, id: "cS")</div>
                    <div><label class="f" for="cE">Kết thúc</label>@Ui.TimeSelect("end", n.End, end: true, id: "cE")</div>
                </div>
                <label class="f" for="cT">Nội dung</label>
                <input class="in" id="cT" name="title" value="@n.Title" required maxlength="@KhDuyet.TitleMax">
                <div class="btn-row" style="margin-top:14px"><button type="button" class="btn" data-x="close">Hủy</button>
                    <button class="btn btn-primary">Lưu</button></div>
            </form>
        </template>
    }
}
