@model KhDuyetVm
@* Leader → Kế hoạch & duyệt → Kế hoạch: port ldApprove() (+ handler ldDecide / ldUndo / ldNote / xDecide).
   Bộ lọc: ?ap=all|pend (seg 'ldAp'), ?pj= (selPj 'ldPf'). *@
@{
    var req = Context.Request;
    var d = Scope.Date;
    var canWrite = Scope.CanLead && !Scope.IsReadOnly;
}
<partial name="_KeHoachTabs" model="@("duyet")" />
<partial name="_DayBar" />
@Ui.Seg(new[]
{
    (Ui.Here(req, ("ap", null)), $"Nhân viên đề xuất ({Model.Filtered.Count})", Model.Mode == "all", 0),
    (Ui.Here(req, ("ap", "pend")), "Chờ duyệt", Model.Mode == "pend", Model.Pending.Count),
})
@* selPj('ldPf', true): lọc dự án *@
<form method="get" action="@req.Path">
    @foreach (var kv in req.Query.Where(k => k.Key != "pj"))
    {
        <input type="hidden" name="@kv.Key" value="@kv.Value">
    }
    <label class="row" style="margin-bottom:12px"><span class="note" style="white-space:nowrap">Dự án:</span>
        <select class="in" name="pj" data-autosubmit>
            <option value="">Tất cả</option>
            @foreach (var p in D.ActivePj())
            {
                <option value="@p.Id" selected="@(Model.Pj == p.Id)">@p.Name</option>
            }
        </select></label>
</form>
@if (Model.NotSent.Count > 0)
{
    <p class="note">Chưa gửi kế hoạch: @string.Join(", ", Model.NotSent.Select(p => p.Name))</p>
}
@if (Model.List.Count == 0)
{
    <div class="empty">@(Model.Mode == "pend" ? "Không còn kế hoạch chờ duyệt." : "Chưa có nhân viên gửi kế hoạch ngày này.")</div>
}
@foreach (var p in Model.List)
{
    var st = Dept.PlanSt(p);
    var name = D.PName(p.EmployeeId);
    <section class="card apv">
        <div class="hd">@Ui.Av(name)<b>@name <span class="note mono">gửi @VnTime.Hm(p.SentAt)</span></b>@Ui.Pill(st)</div>
        @Blocks.PlanMeta(p)
        @D.PlanTable(p)
        @if (!string.IsNullOrEmpty(p.Note))
        {
            <div class="cmt"><b>Nhân viên ghi chú:</b> @p.Note</div>
        }
        @if (!string.IsNullOrEmpty(p.LeaderNote))
        {
            <div class="cmt"><b>Góp ý Leader:</b> @p.LeaderNote</div>
        }
        @if (!string.IsNullOrEmpty(p.TpNote))
        {
            <div class="cmt"><b>Ý kiến TP:</b> @p.TpNote</div>
        }
        @* applyRO: chế độ chỉ xem chỉ ẩn nút, vẫn hiện dòng "Leader đã duyệt … lúc …" *@
        @if (p.LeaderDecision is null)
        {
            if (canWrite)
            {
                <div class="btn-row">
                    <form method="post" action="/KeHoach/QuyetDinhKeHoach" asp-antiforgery="true">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@p.Id"><input type="hidden" name="v" value="ok">
                        <button class="btn btn-ok">✓ Duyệt</button>
                    </form>
                    <form method="post" action="/KeHoach/QuyetDinhKeHoach" asp-antiforgery="true"
                          data-prompt="Từ chối kế hoạch của @name" data-prompt-label="Lý do / hướng dẫn sửa" data-prompt-required
                          data-prompt-name="note" data-prompt-value="@p.LeaderNote">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@p.Id"><input type="hidden" name="v" value="no">
                        <button class="btn btn-no">✕ Từ chối</button>
                    </form>
                    <form method="post" action="/KeHoach/GopYKeHoach" asp-antiforgery="true"
                          data-prompt="Góp ý cho @name" data-prompt-label="Nội dung góp ý" data-prompt-name="note" data-prompt-value="@p.LeaderNote">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@p.Id">
                        <button class="btn">Góp ý</button>
                    </form>
                </div>
            }
        }
        else
        {
            <div class="row" style="justify-content:space-between">
                <span class="note">Leader @(p.LeaderDecision == Decision.Ok ? "đã duyệt" : "đã từ chối") lúc @VnTime.Hm(p.LeaderAt)</span>
                @if (canWrite)
                {
                    @* <div> thay <span> của artifact: <form> không hợp lệ bên trong phần tử phrasing *@
                    <div>
                        <form method="post" action="/KeHoach/GopYKeHoach" class="inline" asp-antiforgery="true"
                              data-prompt="Góp ý cho @name" data-prompt-label="Nội dung góp ý" data-prompt-name="note" data-prompt-value="@p.LeaderNote">
                            @Ui.ReturnField(req)
                            <input type="hidden" name="id" value="@p.Id">
                            <button class="btn btn-sm">Góp ý</button>
                        </form>
                        @if (p.TpDecision is null)
                        {
                            <form method="post" action="/KeHoach/HoanTacKeHoach" class="inline" asp-antiforgery="true">
                                @Ui.ReturnField(req)
                                <input type="hidden" name="id" value="@p.Id">
                                <button class="btn btn-sm">Hoàn tác</button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
    </section>
}
@if (Model.PendingExtras.Count > 0)
{
    <section class="card sec">
        <h2>Phát sinh chờ duyệt</h2>
        @foreach (var x in Model.PendingExtras)
        {
            @D.ExtraRow(x)
            if (canWrite)
            {
                <div class="btn-row" style="margin:0 0 8px 32px">
                    <form method="post" action="/KeHoach/DuyetPhatSinh" asp-antiforgery="true">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@x.Id">
                        <button class="btn btn-sm btn-ok">Duyệt</button>
                    </form>
                    <form method="post" action="/KeHoach/TuChoiPhatSinh" asp-antiforgery="true"
                          data-prompt="Từ chối phát sinh" data-prompt-label="Lý do" data-prompt-required data-prompt-name="reason">
                        @Ui.ReturnField(req)
                        <input type="hidden" name="id" value="@x.Id">
                        <button class="btn btn-sm btn-no">Từ chối</button>
                    </form>
                </div>
            }
        }
    </section>
}
