@model KhDuAnVm
@* ldItems(): chip dự án (?pj=id|new), projForm(p), bảng đầu mục (đổi trạng thái itemSt, xóa delItem), itemForm. *@
@{
    var req = Context.Request;
    var p = Model.Project;
}
<partial name="_KeHoachTabs" model="@("da")" />
<div class="pchips">
    @foreach (var x in Model.Projects)
    {
        <a class="pchip" href="@Ui.Here(req, ("pj", x.Id.ToString()))" aria-pressed="@(Model.Key == x.Id.ToString() ? "true" : "false")">@x.Name</a>
    }
    <a class="pchip" href="@Ui.Here(req, ("pj", "new"))" aria-pressed="@(Model.Key == "new" ? "true" : "false")">＋ Dự án mới</a>
</div>
@* projForm(p) *@
<form id="projForm" class="card sec" method="post" action="/KeHoach/LuuDuAn" asp-antiforgery="true">
    <h2>@(p is not null ? "Thông tin dự án" : "Dự án mới")</h2>
    @Ui.ReturnField(req)
    @if (p is not null)
    {
        <input type="hidden" name="id" value="@p.Id">
    }
    <label class="f" for="fpN" style="margin-top:0">Tên dự án</label><input class="in" id="fpN" name="name" value="@(p?.Name ?? "")" maxlength="200" required>
    <div class="grid2"><div><label class="f" for="fpF">Nhà máy</label><input class="in" id="fpF" name="factory" value="@(p?.Factory ?? "")" maxlength="200"></div><div><label class="f" for="fpL">Địa điểm</label><input class="in" id="fpL" name="location" value="@(p?.Location ?? "")" maxlength="200"></div>
        <div><label class="f" for="fpS">Bắt đầu</label><input class="in" type="date" id="fpS" name="start" value="@(KhManage.Iso(p?.StartDate) ?? "")"></div><div><label class="f" for="fpE">Kết thúc</label><input class="in" type="date" id="fpE" name="end" value="@(KhManage.Iso(p?.EndDate) ?? "")"></div>
        <div><label class="f" for="fpK">Nhu cầu nhân sự/ngày</label><input class="in" type="number" min="0" id="fpK" name="need" value="@(p?.Need ?? 2)"></div>
        <div><label class="f" for="fpO">Trạng thái</label><select class="in" id="fpO" name="statusOverride"><option value="">Tự động theo tiến độ</option>
            @foreach (var s in KhManage.OverrideStates)
            {
                <option value="@s" selected="@(p?.StatusOverride == s)">@Labels.Of(s)</option>
            }
        </select></div></div>
    @if (p is not null)
    {
        <label class="row" style="margin-top:10px"><input type="checkbox" id="fpC" name="closed" value="true" checked="@p.Closed"> Đã bàn giao (chuyển sang Đã hoàn thành)</label>
    }
    <button class="btn btn-primary btn-block" style="margin-top:12px">@(p is not null ? "Lưu thông tin" : "Tạo dự án")</button>
</form>
@if (p is not null)
{
    var it = D.ItemsOf(p.Id);
    var done = it.Count(i => i.Status == TaskState.HoanThanh);
    <section class="card sec"><h2>Đầu mục kế hoạch (@done/@it.Count xong)</h2>
        @if (it.Count > 0)
        {
            <div class="tbl-wrap"><table><thead><tr><th class="n">#</th><th>Đầu mục</th><th class="n">Thời gian</th><th>Trạng thái</th><th></th></tr></thead><tbody>
                @for (int k = 0; k < it.Count; k++)
                {
                    var i = it[k];
                    <tr><td class="n">@(k + 1)</td><td>@i.Title</td><td class="n" style="white-space:nowrap">@Fmt.Dm(i.StartDate)–@Fmt.Dm(i.EndDate)</td>
                        <td><form method="post" action="/KeHoach/TrangThaiDauMuc" asp-antiforgery="true" class="inline">@Ui.ReturnField(req)<input type="hidden" name="id" value="@i.Id">
                            <select class="in" style="padding:4px 6px;font-size:12.5px" name="status" id="itSt@(i.Id)" data-autosubmit aria-label="Trạng thái">
                                @foreach (var s in KhManage.ItemStates)
                                {
                                    <option value="@s" selected="@(i.Status == s)">@Labels.Of(s)</option>
                                }
                            </select></form></td>
                        <td><form method="post" action="/KeHoach/XoaDauMuc" asp-antiforgery="true" class="inline" data-confirm="Xóa đầu mục này khỏi kế hoạch dự án?" data-confirm-label="Xóa">@Ui.ReturnField(req)<input type="hidden" name="id" value="@i.Id"><button class="link" style="color:var(--bad)" aria-label="Xóa đầu mục">✕</button></form></td></tr>
                }
            </tbody></table></div>
        }
        else
        {
            <p class="note">Chưa có đầu mục.</p>
        }
        <form id="itemForm" style="margin-top:10px" method="post" action="/KeHoach/ThemDauMuc" asp-antiforgery="true">
            @Ui.ReturnField(req)
            <input type="hidden" name="projectId" value="@p.Id">
            <label class="f" for="niT">Thêm đầu mục</label><input class="in" id="niT" name="title" placeholder="VD: Chạy dry run" maxlength="300" required>
            <div class="grid2"><div><label class="f" for="niS">Bắt đầu</label><input class="in" type="date" id="niS" name="start" value="@(KhManage.Iso(p.StartDate) ?? "")"></div><div><label class="f" for="niE">Kết thúc</label><input class="in" type="date" id="niE" name="end" value="@(KhManage.Iso(p.EndDate) ?? "")"></div></div>
            <button class="btn btn-primary btn-block" style="margin-top:10px">Thêm đầu mục</button>
        </form>
    </section>
}
