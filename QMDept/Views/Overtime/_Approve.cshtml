@model OvertimeVm
@* otApprove(d): TP duyệt đăng ký làm thêm của Leader (Leader duyệt đăng ký của NV ở Planning → Kế hoạch đề xuất — yêu cầu 2026-10-19).
   Từ chối bắt buộc lý do; có Hoàn tác; duyệt cả kết quả làm thêm. Thẻ: _OtCard. *@
@{
    var forStaff = Scope.Role == Role.Leader;
}
@if (Model.Approve.Count == 0)
{
    <div class="empty">Chưa có @(forStaff ? "nhân viên" : "Leader") đăng ký làm thêm ngày này.</div>
}
@foreach (var x in Model.Approve)
{
    <partial name="_OtCard" model="x" />
}
