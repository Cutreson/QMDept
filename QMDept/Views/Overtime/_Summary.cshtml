@model OvertimeVm
@* otSummary(d): KPI, giờ làm thêm, danh sách; TP / Quản trị đặt hạn đăng ký làm thêm (yêu cầu 2026-10-21; đã bỏ chi phí dự kiến và gửi HCNS). *@
@{
    var req = Context.Request;
    var d = Scope.Date;
    var all = Model.Summary;
    int rice = all.Count(x => OtRules.IsFullMeal(x.Meal)), snack = all.Count(x => x.Meal == OtMeal.Snack), allowance = all.Count(x => x.Allowance > 0);
    int pendingCount = all.Count(x => x.Status is OtStatus.Pending or OtStatus.PendingManager), lateCount = all.Count(x => x.Reg == OtReg.Late);
    // Giờ làm thêm được tính = kết quả đã được duyệt (bị từ chối / chưa duyệt kết quả thì không tính).
    var counted = all.Where(x => x.Completion == OtCompletion.Approved).Sum(x => x.ActualHours ?? 0);
    int doneRejected = all.Count(x => x.Completion == OtCompletion.Rejected), donePending = all.Count(x => x.Status == OtStatus.Approved && x.Completion == OtCompletion.Pending);
}
<div class="kpis k4">
    <div class="kpi k-info"><b>@all.Count</b><span>Người làm thêm</span></div>
    <div class="kpi k-ok"><b>@rice</b><span>Suất cơm</span></div>
    <div class="kpi k-warn"><b>@snack</b><span>Ăn nhẹ</span></div>
    <div class="kpi k-mgr"><b>@allowance</b><span>Phụ cấp 20k</span></div>
</div>
<section class="card sec">
    <h2>Giờ làm thêm</h2>
    <dl class="kvl">
        <dt>Giờ làm thêm được tính</dt><dd class="mono">@Fmt.Num(counted) giờ <span class="note">(chỉ tính kết quả đã được duyệt)</span></dd>
    </dl>
    @if (doneRejected > 0 || donePending > 0)
    {
        <p class="note">@if (donePending > 0) { <b>@donePending</b><text> kết quả làm thêm chờ duyệt. </text> }@if (doneRejected > 0) { <b class="red">@doneRejected</b><text> kết quả bị từ chối — giờ không được tính, nhân sự cần cập nhật lại.</text> }</p>
    }
    @if (pendingCount > 0 || lateCount > 0)
    {
        <p class="note" style="margin-bottom:0">@if (pendingCount > 0)
            {
                <b>@pendingCount</b><text> đăng ký còn chờ duyệt. </text>
            }@if (lateCount > 0)
            {
                <b class="red">@lateCount</b><text> đăng ký trễ hạn @OtRules.DeadlineHhmm, không đảm bảo bố trí suất ăn.</text>
            }</p>
    }
</section>
<section class="card sec">
    <h2>Danh sách (@all.Count)</h2>
    @if (all.Count > 0)
    {
        <div class="tbl-wrap"><table><thead><tr><th>Họ tên</th><th class="n">Giờ</th><th>Suất ăn</th><th>Duyệt</th><th>Kết quả (giờ tính)</th><th>Hạn ĐK</th></tr></thead><tbody>
            @foreach (var x in all)
            {
                <tr>
                    <td><b>@D.PName(x.PersonId)</b><div class="note">@Labels.Of(x.Role)@(x.ProjectId is not null ? " · " + D.PjName(x.ProjectId) : "")</div></td>
                    <td class="n" style="white-space:nowrap">@x.Start–@x.End</td>
                    <td>@(x.Exempt ? "Không áp dụng" : x.Meal == OtMeal.Rice ? "Cơm" : x.Meal == OtMeal.Snack ? "Ăn nhẹ" : "—")@if (x.Allowance > 0)
                        {
                            <text> </text><span class="pill p-info">+20k</span>
                        }</td>
                    <td>@Ui.Pill(x.Status)</td>
                    <td>@if (x.Status != OtStatus.Approved) { <text>—</text> } else if (x.Completion == OtCompletion.Approved) { <b class="mono">@Fmt.Num(x.ActualHours ?? 0) giờ</b> } else { @Ui.Pill(OvertimeUi.CompletionLabel(x.Completion), OvertimeUi.CompletionClass(x.Completion)) }</td>
                    <td>@Ui.Pill(x.Reg)</td>
                </tr>
            }
        </tbody></table></div>
    }
    else
    {
        <p class="note">Chưa có đăng ký làm thêm ngày này.</p>
    }
</section>
@if (Scope.IsManager)
{
    @* Hạn đăng ký làm thêm cho TOÀN BỘ nhân sự: mặc định 15:00, Trưởng phòng chỉnh linh động (08:00–20:00) *@
    <section class="card sec">
        <h2>Hạn đăng ký làm thêm</h2>
        <form method="post" action="@OvertimeUi.PostUrl(req, "SetDeadline", Scope.Date)" asp-antiforgery="true">
            @Ui.ReturnField(req)
            <label class="f" for="otDl" style="margin-top:0">Đăng ký làm thêm trước giờ</label>
            <div class="row" style="gap:8px">
                <div style="flex:1;min-width:0">@Ui.TimeSelect("deadline", OtRules.DeadlineHhmm, end: true, id: "otDl")</div>
                <button class="btn btn-primary">Lưu</button>
            </div>
        </form>
    </section>
}
@if (Scope.Account.Role != Role.Staff)
{
    <partial name="~/Views/Overtime/_OtMonth.cshtml" />
}
