@model OvertimeVm
@* otScreen(): tiêu đề, thanh ngày, hạn đăng ký (otDeadline), tab con cho Leader/TP → otMine / otApprove / otSummary. *@
@{
    ViewData["Title"] = "Đăng ký làm thêm tại công ty";
    var req = Context.Request;
    var d = Scope.Date;
}
@{ var mgrApprove = Scope.Role == Role.Manager && Model.Tab is "approve" or "summary"; }
@if (mgrApprove)
{
    @* TP / Quản trị: duyệt làm thêm của Leader + tổng hợp suất ăn thuộc tab Phê duyệt (yêu cầu 2026-10-21) *@
    @Ui.Head(2, "Chi tiết & phê duyệt")
    <partial name="_MgrApprovalTabs" model="@("ot")" />
    @Ui.Subtabs(new List<(string Href, string Label, bool Active)>
    {
        (Ui.Here(req, ("tab", "approve"), ("edit", null)), "Duyệt đăng ký làm thêm" + (Model.Pending > 0 ? $" ({Model.Pending})" : ""), Model.Tab == "approve"),
        (Ui.Here(req, ("tab", "summary"), ("edit", null)), "Tổng hợp suất ăn", Model.Tab == "summary"),
    })
}
else
{
    @Ui.Head(0, "Đăng ký làm thêm tại công ty")
    @if (Scope.Role is Role.Manager or Role.Leader)
    {
        <partial name="_MgrStatusTabs" model="@(Model.Tab == "summary" ? "summary" : "ot")" />
    }
}
<partial name="_DayBar" />
@if (!mgrApprove) { @OvertimeUi.Deadline(d) }
@if (Model.Tab == "approve")
{
    <partial name="_Approve" model="Model" />
}
else if (Model.Tab == "summary")
{
    <partial name="_Summary" model="Model" />
}
else
{
    <partial name="_Mine" model="Model" />
}
@section Scripts {
    @if (Model.Tab == "mine")
    {
        <script src="~/js/overtime.js" asp-append-version="true"></script>
    }
}
