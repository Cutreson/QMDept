@model OvertimeVm
@* otScreen(): tiêu đề, thanh ngày, hạn đăng ký (otDeadline), tab con cho Leader/TP → otMine / otApprove / otSummary. *@
@{
    ViewData["Title"] = "Đăng ký làm thêm tại công ty";
    var req = Context.Request;
    var d = Scope.Date;
}
@Ui.Head(0, "Đăng ký làm thêm tại công ty")
@if (Scope.Role == Role.Manager)
{
    <partial name="_MgrStatusTabs" model="@Model.Tab" />
}
<partial name="_DayBar" />
@OvertimeUi.Deadline(d)
@if (Scope.Role != Role.Staff && Scope.Role != Role.Manager)
{
    // Leader: duyệt đăng ký làm thêm của NV nằm ở Kế hoạch & duyệt → Kế hoạch đề xuất (yêu cầu 2026-10-19); chỉ TP còn tab "Duyệt Leader".
    var tabsList = new List<(string Href, string Label, bool Active)> { (Ui.Here(req, ("tab", "mine"), ("edit", null)), "Của tôi", Model.Tab == "mine") };
    if (Scope.Role == Role.Manager)
        tabsList.Add((Ui.Here(req, ("tab", "approve"), ("edit", null)), $"Duyệt Leader{(Model.Pending > 0 ? $" ({Model.Pending})" : "")}", Model.Tab == "approve"));
    tabsList.Add((Ui.Here(req, ("tab", "summary"), ("edit", null)), "Tổng hợp suất ăn", Model.Tab == "summary"));
    @Ui.Subtabs(tabsList)
}
@if (Model.Tab == "approve")
{
    <partial name="_Approve" model="Model" />
}
else if (Model.Tab == "summary")
{
    <partial name="_Summary" model="Model" />
}
else
{
    <partial name="_Mine" model="Model" />
}
@section Scripts {
    @if (Model.Tab == "mine")
    {
        <script src="~/js/overtime.js" asp-append-version="true"></script>
    }
}
