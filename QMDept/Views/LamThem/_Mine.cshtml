@model LamThemVm
@* otMine(d, me, role): đăng ký của tôi (thẻ chi tiết + Sửa / Hủy) hoặc form otForm (gửi / sửa đăng ký).
   Chỉ hiện form và nút thao tác khi đang xem chính mình (Scope.IsSelf); xem người khác → chỉ xem. *@
@{
    var req = Context.Request;
    var d = Scope.Date;
    var role = Scope.Role;
    var me = Scope.Me;
    var x = Model.Mine;
    var self = Scope.IsSelf;
}
@if (me is null)
{
    <div class="empty">Chưa có người dùng ở vai trò này.</div>
}
else if (x is not null && (!Model.Edit || !self))
{
    <section class="card sec">
        <h2><span class="grow">@(self ? "Đăng ký của tôi" : "Đăng ký của " + me.Name) · @Fmt.Dm(d)</span>@Ui.Pill(x.Status)</h2>
        <partial name="_OtDetail" model="x" />
        <p class="note">@(role == Role.Tp ? "Trưởng phòng tự ghi nhận, không cần duyệt."
            : !string.IsNullOrEmpty(x.DecidedBy) ? LamThemUi.DecidedText(x)
            : $"Chờ {(role == Role.Nv ? "Leader" : "Trưởng phòng")} duyệt.")</p>
        @if (self)
        {
            <div class="btn-row">
                <a class="btn btn-ghost" href="@Ui.Here(req, ("edit", Fmt.Key(d)))">Sửa đăng ký</a>
                <form method="post" action="@LamThemUi.PostUrl(req, "Huy", Model.R, Scope.Date)" asp-antiforgery="true"
                      data-confirm="Hủy đăng ký làm thêm ngày @Fmt.Dm(d)?" data-confirm-label="Hủy đăng ký">
                    @Ui.ReturnField(req)
                    <input type="hidden" name="r" value="@Model.R">
                    <button class="btn btn-no">Hủy đăng ký</button>
                </form>
            </div>
        }
    </section>
}
else if (!self)
{
    <div class="empty">Chưa có đăng ký làm thêm ngày này.</div>
}
else
{
    var dt = x?.DayType ?? (d.DayOfWeek == DayOfWeek.Sunday ? OtDayType.Nghi : OtDayType.Lv);
    var start = x?.Start ?? (dt == OtDayType.Nghi ? "08:00" : "17:00");
    var end = x?.End ?? (dt == OtDayType.Nghi ? "17:00" : "20:00");
    var r = OtRules.Calc(dt, start, end);
    var opts = OtRules.MealOptions(r);
    OtMeal? sel = x is not null && opts.Contains(x.Meal) ? x.Meal : opts.Length > 0 ? opts[0] : null;
    var extraText = x is null ? "" : x.Items.Count > 0 ? x.ExtraContent ?? "" : x.Content;
    <form id="otForm" class="card sec" method="post" action="@LamThemUi.PostUrl(req, "Luu", Model.R, Scope.Date)" asp-antiforgery="true">
        @Ui.ReturnField(req)
        <input type="hidden" name="r" value="@Model.R">
        <h2>@(x is not null ? "Sửa đăng ký" : "Đăng ký làm thêm tại công ty") · @Fmt.DayLabel(d)</h2>
        <label class="f" for="otK" style="margin-top:0">Loại ngày</label>
        @Ui.Select("dayType", new[] { OtDayType.Lv, OtDayType.Nghi }.Select(k => (LamThemUi.DayKey(k), Labels.Of(k))), LamThemUi.DayKey(dt), id: "otK")
        <div class="pick2 eq">
            <div><label class="f" for="otS">Giờ bắt đầu</label>@Ui.TimeSelect("start", start, id: "otS")</div>
            <div><label class="f" for="otE">Giờ kết thúc</label>@Ui.TimeSelect("end", end, end: true, id: "otE")</div>
        </div>
        <p class="note" style="margin:6px 0 0">Giờ hành chính 08:00–17:00. Ngày làm việc chỉ đăng ký ngoài khung này; ngày nghỉ / lễ được đăng ký cả giờ hành chính (trừ nghỉ trưa).</p>
        <div class="lv-sum@(r.Ok ? "" : " err")" id="otRule" aria-live="polite">@LamThemUi.RuleBox(r)</div>
        <label class="f" for="otM">Báo cơm tăng ca</label>
        <select class="in" id="otM" name="meal" data-init="@(x is null ? "" : LamThemUi.MealKey(x.Meal))" disabled="@(opts.Length < 2)">
            @foreach (var o in opts)
            {
                <option value="@LamThemUi.MealKey(o)" selected="@(o == sel)">@LamThemUi.MealOptLabel(o)</option>
            }
        </select>
        <p class="note" id="otMealNote" style="margin:4px 0 0">@LamThemUi.MealNote(r)</p>
        <label class="f">Công việc làm tiếp <span class="note">(tích các việc trong ngày chưa xong)</span></label>
        @if (Model.Open.Count > 0)
        {
            <div class="optbox">
                @foreach (var t in Model.Open)
                {
                    <label class="trow"><input type="checkbox" name="task" value="@t.Id" checked="@Model.Picked.Contains(t.Id)"><div><div class="t">@t.Title</div><div class="s">@D.PjName(t.ProjectId) · @Labels.Of(t.Status)</div></div><span class="tm">@t.Start–@t.End</span></label>
                }
            </div>
        }
        else
        {
            <p class="note" style="margin:0">Không có việc chưa xong trong ngày này. Nhập nội dung bên dưới.</p>
        }
        <label class="f" for="otC">Nội dung khác (nếu có)</label>
        <textarea class="in" id="otC" name="extra" maxlength="2000" placeholder="VD: Chuẩn bị vật tư cho ngày mai">@extraText</textarea>
        <button class="btn btn-primary btn-block" style="margin-top:12px">@(x is not null ? "Lưu thay đổi" : "Gửi đăng ký")</button>
        @if (x is not null)
        {
            <a class="btn btn-block" href="@Ui.Here(req, ("edit", null))" style="margin-top:8px">Hủy sửa</a>
        }
        <p class="note" style="margin-bottom:0">@(role == Role.Nv ? "Leader duyệt đăng ký của nhân viên." : role == Role.Leader ? "Trưởng phòng duyệt đăng ký của Leader." : "Đăng ký của Trưởng phòng được ghi nhận ngay.")</p>
    </form>
}
